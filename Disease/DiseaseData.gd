## =========================================================
## DiseaseData.gd
##
## 作用：
## 表示一种“疾病”的数据。
##
## 这个类只负责保存数据，不负责逻辑计算。
## 例如：
## - 疾病名称
## - 症状描述
## - 对应脉象四轴
## - 推荐方剂
##
## 游戏运行时：
##
## DiseaseData
##      ↓
## 病人生成系统
##      ↓
## PulseDrawer 显示脉象
##
## =========================================================

class_name DiseaseData
extends Resource


## =========================================================
## 一、基础信息
## =========================================================

## 疾病唯一ID
## 用于程序内部识别
@export var disease_id: String = ""

## 疾病名称
## 玩家看到的名字
@export var disease_name: String = ""

## 疾病描述
## 可以用于图鉴或医书
@export_multiline var description: String = ""

## 所属分类（可选）
## 例如：
## 表寒
## 表热
## 五脏
## 瘟疫
@export var category: String = ""


## =========================================================
## 二、症状信息
## =========================================================

## 症状列表
## 这些是玩家问诊时看到的描述
##
## 例如：
## ["怕冷","咳嗽","无汗"]
##
## 或：
## ["发热","口渴","咽痛"]
@export var symptoms: Array[String] = []


## =========================================================
## 三、脉象数据（核心）
##
## 四轴模型
##
## 气轴      -> 波峰高度
## 血轴      -> 线条粗细
## 寒热轴    -> 波形速度
## 湿燥轴    -> 波峰间距
##
## 范围统一使用 0.0 ~ 1.0
## =========================================================

## 气轴
## 数值越大：
## 波峰越高
@export_range(0.0, 200.0, 0.1)
var pulse_qi: float = 0.5


## 血轴
## 数值越大：
## 线条越粗
@export_range(0.0, 200.0, 0.1)
var pulse_blood: float = 0.5


## 寒热轴
## 数值越大：
## 波形流动越快
@export_range(0.0, 100.0, 0.1)
var pulse_cold_hot: float = 0.5


## 湿燥轴
## 数值越大：
## 波长越大
## 波峰间距越宽
@export_range(0.0, 100.0, 0.1)
var pulse_wet_dry: float = 0.5


## =========================================================
## 四、推荐方剂
##
## 这个字段用于：
## - 判断玩家是否开对方
## - 医书提示
##
## 只存ID，不直接存方剂对象
## =========================================================

@export var recommended_formula_id: String = ""

## =========================================================
## 六、调试函数
##
## 用于在代码里快速查看疾病信息
## =========================================================

func debug_print() -> void:
	print("疾病:", disease_name)
	print("症状:", symptoms)

	print("脉象：")
	print("  气:", pulse_qi)
	print("  血:", pulse_blood)
	print("  寒热:", pulse_cold_hot)
	print("  湿燥:", pulse_wet_dry)
