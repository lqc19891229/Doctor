[sub_resource type="GDScript" id="GDScript_desk_hotspots"]
script/source = "extends Control

@onready var _pulse_button: Button = get_node(\"../VBoxContainer/ButtonRow/OpenPulseWindowButton\")
@onready var _prescription_button: Button = get_node(\"../VBoxContainer/ButtonRow/OpenPrescriptionWindowButton\")
@onready var _clinical_log_button: Button = get_node(\"../VBoxContainer/ButtonRow/Openclinical_logWindowButton\")

func _ready() -> void:
	$PulseHotspot.pressed.connect(_forward_pulse_pressed)
	$PrescriptionHotspot.pressed.connect(_forward_prescription_pressed)
	$ClinicalLogHotspot.pressed.connect(_forward_clinical_log_pressed)

func _forward_pulse_pressed() -> void:
	_pulse_button.pressed.emit()

func _forward_prescription_pressed() -> void:
	_prescription_button.pressed.emit()

func _forward_clinical_log_pressed() -> void:
	_clinical_log_button.pressed.emit()
"

[sub_resource type="GDScript" id="GDScript_shape_hotspot"]
script/source = "extends Button

@export var hit_polygon: PackedVector2Array = PackedVector2Array()

var _mouse_over := false
var _mouse_down := false

func _ready() -> void:
	mouse_entered.connect(_on_mouse_entered)
	mouse_exited.connect(_on_mouse_exited)
	button_down.connect(_on_button_down)
	button_up.connect(_on_button_up)

func _has_point(point: Vector2) -> bool:
	if hit_polygon.size() < 3:
		return Rect2(Vector2.ZERO, size).has_point(point)
	var normalized_point := Vector2(
		point.x / max(size.x, 1.0),
		point.y / max(size.y, 1.0)
	)
	return Geometry2D.is_point_in_polygon(normalized_point, hit_polygon)

func _draw() -> void:
	if not _mouse_over or hit_polygon.size() < 3:
		return
	var points := PackedVector2Array()
	for normalized_point in hit_polygon:
		points.append(Vector2(normalized_point.x * size.x, normalized_point.y * size.y))
	var fill_color := Color(1.0, 0.72, 0.2, 0.20 if _mouse_down else 0.10)
	var border_color := Color(1.0, 0.84, 0.38, 1.0 if _mouse_down else 0.88)
	draw_colored_polygon(points, fill_color)
	var outline := points.duplicate()
	outline.append(points[0])
	draw_polyline(outline, border_color, 3.0 if _mouse_down else 2.0, true)

func _on_mouse_entered() -> void:
	_mouse_over = true
	queue_redraw()

func _on_mouse_exited() -> void:
	_mouse_over = false
	_mouse_down = false
	queue_redraw()

func _on_button_down() -> void:
	_mouse_down = true
	queue_redraw()

func _on_button_up() -> void:
	_mouse_down = false
	queue_redraw()
"

