[sub_resource type="GDScript" id="GDScript_desk_hotspots"]
script/source = "extends Control\n\n@onready var _pulse_button: Button = get_node(\"../VBoxContainer/ButtonRow/OpenPulseWindowButton\")\n@onready var _prescription_button: Button = get_node(\"../VBoxContainer/ButtonRow/OpenPrescriptionWindowButton\")\n@onready var _clinical_log_button: Button = get_node(\"../VBoxContainer/ButtonRow/Openclinical_logWindowButton\")\n\nfunc _ready() -> void:\n\t$PulseHotspot.pressed.connect(_forward_pulse_pressed)\n\t$PrescriptionHotspot.pressed.connect(_forward_prescription_pressed)\n\t$ClinicalLogHotspot.pressed.connect(_forward_clinical_log_pressed)\n\nfunc _forward_pulse_pressed() -> void:\n\t_pulse_button.pressed.emit()\n\nfunc _forward_prescription_pressed() -> void:\n\t_prescription_button.pressed.emit()\n\nfunc _forward_clinical_log_pressed() -> void:\n\t_clinical_log_button.pressed.emit()\n"

[sub_resource type="GDScript" id="GDScript_shape_hotspot"]
script/source = "extends Button\n\n@export var hit_polygon: PackedVector2Array = PackedVector2Array()\n\nvar _mouse_over := false\nvar _mouse_down := false\n\nfunc _ready() -> void:\n\tmouse_entered.connect(_on_mouse_entered)\n\tmouse_exited.connect(_on_mouse_exited)\n\tbutton_down.connect(_on_button_down)\n\tbutton_up.connect(_on_button_up)\n\nfunc _has_point(point: Vector2) -> bool:\n\tif hit_polygon.size() < 3:\n\t\treturn Rect2(Vector2.ZERO, size).has_point(point)\n\tvar normalized_point := Vector2(\n\t\tpoint.x / max(size.x, 1.0),\n\t\tpoint.y / max(size.y, 1.0)\n\t)\n\treturn Geometry2D.is_point_in_polygon(normalized_point, hit_polygon)\n\nfunc _draw() -> void:\n\tif not _mouse_over or hit_polygon.size() < 3:\n\t\treturn\n\tvar points := PackedVector2Array()\n\tfor normalized_point in hit_polygon:\n\t\tpoints.append(Vector2(normalized_point.x * size.x, normalized_point.y * size.y))\n\tvar fill_color := Color(1.0, 0.72, 0.2, 0.20 if _mouse_down else 0.10)\n\tvar border_color := Color(1.0, 0.84, 0.38, 1.0 if _mouse_down else 0.88)\n\tdraw_colored_polygon(points, fill_color)\n\tvar outline := points.duplicate()\n\toutline.append(points[0])\n\tdraw_polyline(outline, border_color, 3.0 if _mouse_down else 2.0, true)\n\nfunc _on_mouse_entered() -> void:\n\t_mouse_over = true\n\tqueue_redraw()\n\nfunc _on_mouse_exited() -> void:\n\t_mouse_over = false\n\t_mouse_down = false\n\tqueue_redraw()\n\nfunc _on_button_down() -> void:\n\t_mouse_down = true\n\tqueue_redraw()\n\nfunc _on_button_up() -> void:\n\t_mouse_down = false\n\tqueue_redraw()\n"

