[sub_resource type="Resource" id="TutorialSlide_1"]
script = ExtResource("3_slide_data")
title = "坐堂问诊"
description = "白天在诊室接待病人。先了解病情，再依次进行诊脉、记录与开方。"
caption = "诊室总览"
image = ExtResource("4_slide_image_1")

[sub_resource type="Resource" id="TutorialSlide_2"]
script = ExtResource("3_slide_data")
title = "诊脉辨证"
description = "点击诊脉入口查看六部脉象。结合病人的叙述与脉象，判断可能的证候。"
caption = "诊桌与诊脉入口"
image = ExtResource("5_slide_image_2")

[sub_resource type="Resource" id="TutorialSlide_3"]
script = ExtResource("3_slide_data")
title = "开具处方"
description = "在处方窗口选择药材与用量。提交前可以返回检查，确认后系统会评估疗效。"
caption = "开方与确认"
image = ExtResource("6_slide_image_3")

[sub_resource type="Resource" id="TutorialSlide_4"]
script = ExtResource("3_slide_data")
title = "夜读医书"
description = "结束白天后进入夜晚。阅读已解锁医书，可以补全病证、方剂与药材知识。"
caption = "夜晚与医书"
image = ExtResource("7_slide_image_4")

