[node name="TutorialSlideshow" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
script = ExtResource("1_script")
titles = PackedStringArray("白天行医", "观察病情", "切脉辨证", "理解脉象", "查阅行医记考", "断病开方", "君臣佐使", "夜晚读书", "开始行医")
descriptions = PackedStringArray("白天会有病人来到医馆。正确治疗病人，可以获得银钱、名望和行医心得。", "仔细阅读病人的描述，从症状、年龄和身体状态中寻找判断疾病的线索。", "点击把脉按钮，按住 Q、A、Z、W、S、X，可以查看不同部位的脉象。", "波峰高低反映气，线条粗细反映血，波速反映寒热，波宽反映湿燥。", "忘记疾病、药材或方剂时，可以打开行医记考，查阅已经掌握的内容。", "打开处方窗口后，先选择疾病，再选择药材、剂量以及对应的配伍区域。", "君药治疗主症，臣药协助君药，佐药制约或兼治，使药负责调和与引经。", "白天结束后进入夜晚。阅读新获得的医书条目，可以解锁药材、方剂和疾病。", "白天行医，夜晚读书，在有限的时间里积累银钱与名望，推动故事走向结局。")

