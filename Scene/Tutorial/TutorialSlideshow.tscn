[node name="TutorialSlideshow" type="Control"]
editor_description = "全屏截图聚光灯教程 V2：四块遮罩、高亮框、箭头和自动避让说明框。"
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
script = ExtResource("1_script")
titles = PackedStringArray("白天行医", "观察病情", "切脉辨证", "理解脉象", "查阅行医记考", "断病开方", "君臣佐使", "夜晚读书", "开始行医")
descriptions = PackedStringArray("白天会有病人来到医馆。正确治疗病人，可以获得银钱、名望和行医心得。", "仔细阅读病人的描述，从症状、年龄和身体状态中寻找判断疾病的线索。", "点击把脉按钮，按住 Q、A、Z、W、S、X，可以查看不同部位的脉象。", "波峰高低反映气，线条粗细反映血，波速反映寒热，波宽反映湿燥。", "忘记疾病、药材或方剂时，可以打开行医记考，查阅已经掌握的内容。", "打开处方窗口后，先选择疾病，再选择药材、剂量以及对应的配伍区域。", "君药治疗主症，臣药协助君药，佐药制约或兼治，使药负责调和与引经。", "白天结束后进入夜晚。阅读新获得的医书条目，可以解锁药材、方剂和疾病。", "白天行医，夜晚读书，在有限的时间里积累银钱与名望，推动故事走向结局。")
focus_rects = Array[Rect2]([Rect2(0.04, 0.08, 0.92, 0.8), Rect2(0.35, 0.24, 0.3, 0.56), Rect2(0.73, 0.7, 0.2, 0.17), Rect2(0.12, 0.12, 0.58, 0.6), Rect2(0.73, 0.7, 0.2, 0.17), Rect2(0.05, 0.07, 0.9, 0.82), Rect2(0.42, 0.34, 0.52, 0.46), Rect2(0.7, 0.69, 0.24, 0.18), Rect2(0.04, 0.07, 0.92, 0.82)])
callout_sides = PackedStringArray("bottom", "right", "left", "right", "left", "bottom", "left", "left", "top")

