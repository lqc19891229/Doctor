## =========================================================
## NpcData.gd
##
## 脚本功能：
## 定义病人 NPC 的数据结构，用于保存病人 NPC 的身份、外观、疾病和诊疗状态。
##
## 说明：
## 这个脚本只存数据，不负责任何游戏逻辑。
## 每一个 NPC 实例都可以保存：
## 名字，性别，年龄，头像，当前疾病。
##
## random NPC 与 story NPC 使用同一份数据结构：
## - random：平日诊室刷新时，从 Data/Npc 中随机抽取的常规病人
## - story：剧情指定的手动 NPC，由剧情按 npc_id 精确选择
## =========================================================

class_name NpcData
extends Resource


## =========================================================
## 一、基础身份信息
## =========================================================

## NPC 唯一 ID。
## random / story 都建议在 .tres 中手动填写固定 ID。
## story NPC 必须填写，用于剧情按 ID 精确选择。
@export var npc_id: String = ""

## NPC 类型：
## random = 平日诊室刷新用的常规病人
## story = 剧情指定病人
@export_enum("random", "story") var npc_type: String = "random"

## NPC 名字
@export var npc_name: String = ""

## 性别
@export var gender: String = "男"

## 年龄
@export var age: int = 20


## =========================================================
## 二、外观信息
## =========================================================

## NPC 头像或立绘
@export var portrait: Texture2D


## =========================================================
## 三、疾病信息
## =========================================================

## 当前疾病。
## NPC 来看病时，脉象、标准方和判定都从这里读取。
@export var disease: DiseaseData


## =========================================================
## 四、诊疗状态
## =========================================================

## 是否已经被治疗。
## 随机 NPC 生成时默认为 false。
## 后续可以用于病人队列、剧情或任务系统。
@export var is_treated: bool = false
