## =========================================================
## NpcData.gd
##
## 脚本功能：
## 定义病人 NPC 的数据结构，用于保存病人 NPC 的身份、外观、疾病和诊疗状态。
##
## 说明：
## 这个脚本只存数据，不负责任何游戏逻辑。
## 每一个 NPC 实例都可以保存：
## 名字，性别，年龄，头像，当前疾病
##
## 以后可以通过 NPCData.disease 直接获取脉象数据。
## =========================================================

class_name NpcData
extends Resource


## =========================================================
## 一、基础身份信息
## =========================================================

## NPC 唯一ID（方便以后存档或生成）
@export var npc_id: String = ""

## NPC 名字
@export var npc_name: String = ""

## 性别
@export var gender: String = "男"

## 年龄
@export var age: int = 20


## =========================================================
## 二、外观信息
## =========================================================

## NPC 头像或立绘
@export var portrait: Texture2D


## =========================================================
## 三、疾病信息
## =========================================================

## 当前疾病
## 这里直接引用 DiseaseData
## NPC 来看病时，脉象就是从这里读取
@export var disease: DiseaseData


## =========================================================
## 四、诊疗状态
## =========================================================

## 是否已经被治疗
## 以后用于剧情或任务系统
@export var is_treated: bool = false
