[resource]
script = ExtResource("2")
formula_id = "qing_qi_hua_tan_wan"
formula_name = "清气化痰丸"
detail_text = "清气化痰丸\n【出处】《医方考》\n【功效】清热化痰，理气止咳\n【主治】痰热壅肺\n【组成】\n君：胆南星 一两五钱\n臣：半夏 一两五钱，瓜蒌仁 一两，黄芩 一两\n佐：杏仁 一两，陈皮 一两，枳实 一两，茯苓 一两\n使：生姜 三两\n【配伍】\n胆南星：清热化痰，专治痰热壅肺。\n瓜蒌仁：清热化痰、润肺下气、宽胸散结；\n黄芩：清泻肺火，助南星清化痰热。\n杏仁、半夏：降利肺气、化痰止咳\n陈皮、枳实：理气破结，气顺痰自消\n茯苓：健脾渗湿，杜绝生痰之源\n生姜：制胆南星、半夏之毒"
target_disease_id = "tan_re_yong_fei"
target_disease_name = "痰热壅肺"
jun_group = [SubResource("Ingredient_1")]
chen_group = [SubResource("Ingredient_2"), SubResource("Ingredient_3"), SubResource("Ingredient_4")]
zuo_group = [SubResource("Ingredient_5"), SubResource("Ingredient_6"), SubResource("Ingredient_7"), SubResource("Ingredient_8")]
shi_group = [SubResource("Ingredient_9")]
