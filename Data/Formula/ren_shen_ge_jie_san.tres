[resource]
script = ExtResource("2")
formula_id = "ren_shen_ge_jie_san"
formula_name = "人参蛤蚧散"
detail_text = "人参蛤蚧散\n【出处】《博济方》\n【功效】补肺益肾，纳气定喘，止咳化痰\n【主治】肾不纳气\n【组成】\n君：蛤蚧 五钱，人参 四钱\n臣：知母 三钱，贝母 三钱，桑白皮 三钱\n佐：茯苓 四钱，杏仁 四钱\n使：甘草 三钱\n【配伍】\n蛤蚧：补肺益肾、温肾纳气、定喘止嗽，专治肾不纳气虚喘。\n人参：大补元气、补益肺气，助蛤蚧固本益气。\n杏仁、贝母：润肺化痰、降气止咳\n桑白皮、知母：清泻肺热、润燥止咳\n茯苓：健脾渗湿、杜绝生痰之源\n炙甘草：益气和中，调和诸药。"
target_disease_id = "shen_bu_na_qi"
target_disease_name = "肾不纳气"
jun_group = []
chen_group = []
