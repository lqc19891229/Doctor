[resource]
script = ExtResource("2")
formula_id = "xiao_qing_long_tang"
formula_name = "小青龙汤"
detail_text = "小青龙汤\n【出处】《伤寒论》\n【功效】解表散寒，温肺化饮\n【主治】表寒里饮\n【组成】\n君：麻黄 三钱，桂枝 三钱\n臣：干姜 二钱，细辛 二钱\n佐：白芍 三钱，五味子 二钱，半夏 三钱\n使：甘草 二钱\n【配伍】\n麻黄、桂枝：麻黄发汗解表、宣肺平喘；桂枝解肌通阳，温散肌表风寒。\n干姜、细辛：干姜温脾肺，散脏腑寒邪、化水饮；细辛温散少阴寒饮，既助麻桂解表，又入肺内化伏饮。\n半夏：燥湿化痰，降逆止咳，消胸膈水饮痰浊；\n五味子：酸收敛肺止咳。防麻、桂、姜、辛辛温发散太过耗伤肺气，散收并用；\n白芍：酸寒敛阴和营。防诸辛温药耗伤阴血，制约燥烈之性。\n炙甘草：调和全方；益气补中，顾护脾胃，缓和麻、辛、干姜峻烈之性。"
target_disease_id = "biao_han_li_yin"
target_disease_name = "表寒里饮"
jun_group = [SubResource("Ingredient_1"), SubResource("Ingredient_2")]
chen_group = [SubResource("Ingredient_3"), SubResource("Ingredient_4")]
zuo_group = [SubResource("Ingredient_5"), SubResource("Ingredient_6"), SubResource("Ingredient_7")]
shi_group = [SubResource("Ingredient_8")]
