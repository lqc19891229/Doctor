[resource]
script = ExtResource("2")
formula_id = "tai_shan_pan_shi_san"
formula_name = "泰山磐石散"
detail_text = "泰山磐石散\n【出处】《景岳全书》\n【功效】益气健脾，养血安胎\n【主治】妊娠\n【组成】\n君：白术 二钱\n臣：人参 一钱，黄芪 一钱，续断 一钱，熟地黄 一钱，当归 一钱\n佐：白芍 八分，川芎 八分，黄芩 一钱，砂仁 五分\n使：甘草 五分，糯米 五分\n【配伍】\n人参、黄芪、白术：脾胃为气血生化之源，健脾益气以固胎之本。\n当归、熟地、白芍、川芎：养血和血，补益冲任。冲为血海，任主胞胎，血足则养胎。\n续断：补肝肾、固冲任、安胎；肾主系胎。\n黄芩：清热安胎。\n砂仁：理气和胃，醒脾行滞；防补药滋腻碍胃，使气血流通，胎气安和。\n炙甘草：益气和中，调和诸药；\n糯米：补脾养胃，滋养胎元。"
target_disease_id = "ren_shen"
target_disease_name = "妊娠"
jun_group = [SubResource("Ingredient_1")]
chen_group = [SubResource("Ingredient_2"), SubResource("Ingredient_3"), SubResource("Ingredient_4"), SubResource("Ingredient_5"), SubResource("Ingredient_6")]
zuo_group = [SubResource("Ingredient_7"), SubResource("Ingredient_8"), SubResource("Ingredient_9"), SubResource("Ingredient_10")]
shi_group = [SubResource("Ingredient_11"), SubResource("Ingredient_12")]
