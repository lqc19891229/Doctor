[resource]
script = ExtResource("2")
formula_id = "jin_suo_gu_jing_wan"
formula_name = "金锁固精丸"
detail_text = "金锁固精丸\n【出处】《医方集解》\n【功效】补肾涩精，固摄肾气\n【主治】肾气不固\n【组成】\n君：沙苑子 五钱\n臣：芡实 五钱\n佐：龙骨 五钱，牡蛎 五钱，莲须 三钱\n使：莲子 三两\n【配伍】\n沙苑子：补肾益精、平补肝肾，固本培元。\n芡实：健脾益肾、固涩精气。\n莲须：专涩精；\n龙骨、牡蛎：重镇收敛、固涩滑脱。\n莲子：养心安神，补肾涩精，制丸药赋形"
target_disease_id = "shen_qi_bu_gu"
target_disease_name = "肾气不固"
jun_group = [SubResource("Ingredient_1")]
chen_group = [SubResource("Ingredient_2")]
zuo_group = [SubResource("Ingredient_3"), SubResource("Ingredient_4"), SubResource("Ingredient_5")]
shi_group = [SubResource("Ingredient_6")]
