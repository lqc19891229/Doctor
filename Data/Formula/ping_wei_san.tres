[resource]
script = ExtResource("2")
formula_id = "ping_wei_san"
formula_name = "平胃散"
detail_text = "平胃散\n\n【出处】\n《太平惠民和剂局方》\n\n【功效】\n燥湿运脾，行气和胃\n\n【主治】\n湿盛困脾\n\n【组成】\n君：苍术 三钱\n臣：厚朴 二钱\n佐：陈皮 二钱\n使：甘草 一钱\n\n【配伍】\n苍术：苦温燥湿、健脾运脾，专治湿困脾胃。\n厚朴：行气除满、燥湿化浊，消脘腹胀痞。\n陈皮：理气和胃、燥湿醒脾，使气机条达。\n炙甘草：益气和中、调和诸药；姜枣调和脾胃。"
target_disease_id = "shi_sheng_kun_pi"
target_disease_name = "湿盛困脾"
jun_group = [SubResource("Ingredient_1")]
chen_group = [SubResource("Ingredient_2")]
zuo_group = [SubResource("Ingredient_3")]
shi_group = [SubResource("Ingredient_4")]
