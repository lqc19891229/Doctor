[resource]
script = ExtResource("2")
formula_id = "huang_lian_e_jiao_tang"
formula_name = "黄连阿胶汤"
detail_text = "黄连阿胶汤\n【出处】《伤寒论》\n【功效】滋阴降火，交通心肾\n【主治】心肾不交\n【组成】\n君：黄连 四钱\n臣：黄芩 三钱，白芍 三钱\n佐：阿胶 三钱\n使：鸡子黄 一两\n【配伍】\n黄连：苦寒直折，清泻心火、除烦安神。\n黄芩：助黄连清心泻火；\n阿胶：滋阴补肾、养血填阴，滋肾阴以济心火。\n白芍：敛阴和营、柔肝缓急；\n鸡子黄：滋阴润燥、养心安神，入少阴交通心肾。"
target_disease_id = "xin_shen_bu_jiao"
target_disease_name = "心肾不交"
jun_group = [SubResource("Ingredient_1")]
chen_group = [SubResource("Ingredient_2"), SubResource("Ingredient_3")]
zuo_group = [SubResource("Ingredient_4")]
shi_group = [SubResource("Ingredient_5")]
