[resource]
script = ExtResource("2")
formula_id = "gui_zhi_tang"
formula_name = "桂枝汤"
detail_text = "桂枝汤\n【出处】《伤寒论》\n【功效】解肌发表，调和营卫\n【主治】风寒表虚证\n【组成】\n君：桂枝 三钱\n臣：白芍 三钱\n佐：生姜 三钱，大枣 二钱\n使：甘草 二钱\n【配伍】\n桂枝辛散卫邪，白芍酸敛营阴；一散一收，调和营卫，不伤正、不敛邪。\n姜枣相合，调和脾胃，化生气血，资营卫之源。"
target_disease_id = "feng_han_biao_xu_zheng"
target_disease_name = "风寒表虚证"
jun_group = [SubResource("Ingredient_1")]
chen_group = [SubResource("Ingredient_2")]
zuo_group = [SubResource("Ingredient_3"), SubResource("Ingredient_4")]
shi_group = [SubResource("Ingredient_5")]
