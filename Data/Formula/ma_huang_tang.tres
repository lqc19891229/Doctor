[resource]
script = ExtResource("2")
formula_id = "ma_huang_tang"
formula_name = "麻黄汤"
detail_text = "麻黄汤\n【出处】《伤寒论》\n【功效】发汗解表，宣肺平喘\n【主治】风寒表实证\n【组成】\n君：麻黄 三钱\n臣：桂枝 二钱\n佐：杏仁 二钱\n使：甘草 一钱\n【配伍】\n麻桂相须，增强发汗散寒之力，专治表实无汗。\n麻杏相使，宣降相配，专治寒邪闭肺之喘逆。\n甘草调和诸药"
target_disease_id = "feng_han_biao_shi_zheng"
target_disease_name = "风寒表实证"
jun_group = [SubResource("Ingredient_1")]
chen_group = [SubResource("Ingredient_2")]
zuo_group = [SubResource("Ingredient_3")]
shi_group = [SubResource("Ingredient_4")]
