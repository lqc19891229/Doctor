[resource]
script = ExtResource("2")
formula_id = "liu_wei_di_huang_wan"
formula_name = "六味地黄丸"
detail_text = "六味地黄丸\n【出处】《小儿药证直诀》\n【功效】滋阴补肾\n【主治】肾阴虚\n【组成】\n君：熟地黄 八钱\n臣：山茱萸 四钱，山药 四钱\n佐：泽泻 三钱，茯苓 三钱，丹皮 三钱\n使：\n【配伍】\n熟地黄：重用滋阴补肾、填精益髓。\n萸肉：补肝肾、敛精气；\n山药：补脾益肾、固涩下焦。\n泽泻：泻肾浊、防熟地滋腻；\n丹皮：清泻虚火、凉血除蒸；\n茯苓：健脾渗湿、助山药补脾。"
target_disease_id = "shen_yin_xu"
target_disease_name = "肾阴虚"
jun_group = [SubResource("Ingredient_1")]
chen_group = [SubResource("Ingredient_2"), SubResource("Ingredient_3")]
zuo_group = [SubResource("Ingredient_4"), SubResource("Ingredient_5"), SubResource("Ingredient_6")]
shi_group = []
