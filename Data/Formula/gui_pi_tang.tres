[resource]
script = ExtResource("2")
formula_id = "gui_pi_tang"
formula_name = "归脾汤"
detail_text = "归脾汤\n\n【出处】\n《严氏济生方》\n\n【功效】\n益气补血，健脾养心\n\n【主治】\n心脾两虚\n\n【组成】\n君：黄芪 一两，人参 五钱\n臣：龙眼 五钱，白术 五钱，当归 五钱，酸枣仁 六钱\n佐：茯神 五钱，远志 三钱，木香 二钱\n使：甘草 二钱，生姜 一钱，大枣 一钱\n\n【配伍】\n黄芪、人参：大补脾气，益气生血。\n当归、龙眼：肉养血补心、安神。\n白术：助健脾；\n酸枣仁、茯神：宁心安神；\n远志：安神益智、交通心肾；\n木香：理气醒脾，防滋补壅滞碍胃。\n炙甘草、姜枣：益气和中、调和诸药，助脾胃生化气血。"
target_disease_id = "xin_pi_liang_xu"
target_disease_name = "心脾两虚"
jun_group = [SubResource("Ingredient_1"), SubResource("Ingredient_2")]
chen_group = [SubResource("Ingredient_3"), SubResource("Ingredient_4"), SubResource("Ingredient_5"), SubResource("Ingredient_6")]
zuo_group = [SubResource("Ingredient_7"), SubResource("Ingredient_8"), SubResource("Ingredient_9")]
shi_group = [SubResource("Ingredient_10"), SubResource("Ingredient_11"), SubResource("Ingredient_12")]
