[resource]
script = ExtResource("2")
formula_id = "xiao_yao_san"
formula_name = "逍遥散"
detail_text = "逍遥散\n【出处】《太平惠民和剂局方》\n【功效】疏肝解郁，养血健脾\n【主治】肝脾不和（肝郁脾虚）\n【组成】\n君：柴胡 三钱\n臣：当归 三钱，白芍 三钱\n佐：白术 三钱，茯苓 三钱，生姜 一钱，薄荷 一钱\n使：甘草 一钱五分\n【配伍】\n柴胡：疏肝解郁、条达肝气，疏散郁滞。\n当归、白芍：养血柔肝，补肝体、缓肝急；防肝郁化火伤阴。\n白术、茯苓：健脾祛湿、培土荣木；\n生姜：温胃和中、调和气血。\n薄荷：助柴胡疏肝透热、疏散郁遏；\n炙甘草：益气补中，调和诸药；合白芍缓急止痛。"
target_disease_id = "gan_pi_bu_he"
target_disease_name = "肝脾不和"
jun_group = [SubResource("Ingredient_1")]
chen_group = [SubResource("Ingredient_2"), SubResource("Ingredient_3")]
zuo_group = [SubResource("Ingredient_4"), SubResource("Ingredient_5"), SubResource("Ingredient_6"), SubResource("Ingredient_7")]
shi_group = [SubResource("Ingredient_8")]
