portrait_side = "right"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "很多人表面上看着正常，其实都病得不轻呢。"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_009"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "曾和"
text = "胡扯，我看你就是没病说成有病，骗病人买药赚钱"
portrait = ExtResource("portrait_2")
[sub_resource type="Resource" id="StoryLine_010"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "曾和"
text = "咱们家可是花了好多钱，把地都卖了供你读书，就只望着你能出人头地，光宗耀祖。可你怎么就这么不争气呢？"
