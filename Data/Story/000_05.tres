after_play = "endgame"
clinic_npc_id = ""
money_change = 0
reputation_points_change = 0
experience_points_change = 0
play_once = true
sort_index = 0
lines = Array[ExtResource("1_storyline")]([SubResource("StoryLine_001"), SubResource("StoryLine_002"), SubResource("StoryLine_003")])
