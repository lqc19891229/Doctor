[sub_resource type="Resource" id="StoryLine_001"]
script = ExtResource("1_storyline")
line_type = "subtitle"
portrait_side = "auto"
inactive_portrait_mode = "dim"
text = "咚咚咚…"
[sub_resource type="Resource" id="StoryLine_002"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "right"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "谁？"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_003"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "雷万钧"
text = "贤弟，是我。"
portrait = ExtResource("portrait_2")
[sub_resource type="Resource" id="StoryLine_004"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "right"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "雷兄，怎么样，事情有眉目了吗？"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_005"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "雷万钧"
text = "唉…按察司、布政司都不受理，去所部都指挥使司面见老宪台，他老人家说这里面水太深，让我别多管闲事…"
portrait = ExtResource("portrait_2")
[sub_resource type="Resource" id="StoryLine_006"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "right"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "看来这事远比我们想的复杂…"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_007"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "雷万钧"
text = "放任不管的话，是要出大事的..."
portrait = ExtResource("portrait_2")
[sub_resource type="Resource" id="StoryLine_008"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "right"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "我想到了一个能帮上忙的人。"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_009"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "雷万钧"
text = "哦？是谁？"
portrait = ExtResource("portrait_2")
[sub_resource type="Resource" id="StoryLine_010"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "right"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "楚王。"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_011"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "雷万钧"
text = "贤弟认识这么大的人物？"
portrait = ExtResource("portrait_2")
[sub_resource type="Resource" id="StoryLine_012"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "right"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "之前医治过世子，应该能说得上话。"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_013"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "雷万钧"
text = "那还等什么，我陪你现在就去！"
portrait = ExtResource("portrait_2")
[sub_resource type="Resource" id="StoryLine_014"]
script = ExtResource("1_storyline")
line_type = "subtitle"
portrait_side = "auto"
inactive_portrait_mode = "dim"
text = "一路无话，两人来到了楚王府"
background = ExtResource("background_3")
[sub_resource type="Resource" id="StoryLine_015"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "楚王"
text = "前日一别，先生别来无恙啊。"
portrait = ExtResource("portrait_4")
background = ExtResource("background_5")
[sub_resource type="Resource" id="StoryLine_016"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "草民拜见王爷，今日来是有一事请王爷帮忙。"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_017"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "楚王"
text = "先生是犬子的救命恩人，若有本王能帮上忙的，一定尽力而为。"
portrait = ExtResource("portrait_4")
[sub_resource type="Resource" id="StoryLine_018"]
script = ExtResource("1_storyline")
line_type = "subtitle"
portrait_side = "auto"
inactive_portrait_mode = "dim"
text = "李东璧将事情的前因后果如实告诉了楚王"
[sub_resource type="Resource" id="StoryLine_019"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "楚王"
text = "嗯…这些地方官胆子也太大了。可自成祖文皇帝之后，藩王不临民，不治事，干预地方军政是谋逆的大罪，本王也爱莫能助。"
portrait = ExtResource("portrait_4")
[sub_resource type="Resource" id="StoryLine_020"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "这事儿要是您不管，就没人能管了…瘟病若起，湖广将民不聊生啊。"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_021"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "楚王"
text = "此事牵扯甚广，先生就不怕引火烧身吗？"
portrait = ExtResource("portrait_4")
[sub_resource type="Resource" id="StoryLine_022"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "草民自幼读四书五经，诸子百家，文章未成，功名未就，所学所求只有为生民立命，若以我一命换千万民生，吾往矣。"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_023"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "楚王"
text = "先生所言让本王惭愧啊…待我会写一道密奏，向皇上禀明赈灾药材之事。先生也切莫再和别人提及此事。"
portrait = ExtResource("portrait_4")

