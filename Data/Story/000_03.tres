[sub_resource type="Resource" id="StoryLine_007"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "你为官清廉，是官场清流，全家都以你为荣。这书的事儿，咱们再想想办法。"
portrait = ExtResource("portrait_2")
[sub_resource type="Resource" id="StoryLine_008"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "right"
inactive_portrait_mode = "dim"
speaker = "吴芷兰"
text = "老头子，你的恩师顾老先生和当今文坛第一人王世贞是世交，若能请他给你的书写一个序，天下学子必慕名而来，到时候肯定有书商愿意出版此书。"
portrait = ExtResource("portrait_3")
[sub_resource type="Resource" id="StoryLine_009"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "哎呀，还得是你啊老婆子，这主意好，这主意好。"
