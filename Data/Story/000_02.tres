[gd_resource type="Resource" script_class="StoryData" format=3]

[ext_resource type="Script" path="res://System/Story/StoryLine.gd" id="1_storyline"]
[ext_resource type="Script" path="res://System/Story/StoryData.gd" id="2_storydata"]
[ext_resource type="Texture2D" path="res://Assets/Portrait/StoryNpc/hu_cheng_long/hu_cheng_long.png" id="portrait_1"]
[ext_resource type="Texture2D" path="res://Assets/Portrait/StoryNpc/li_dong_bi/li_dong_bi_old.png" id="portrait_2"]

[sub_resource type="Resource" id="StoryLine_001"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "胡承龙"
text = "李老先生，打扰啦。在下胡承龙，是做书籍生意的，听说您有书想要刻板发行？"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_002"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "辛苦胡老板亲自来一趟，在下确实有一部医书想要拜托您发行。"
portrait = ExtResource("portrait_2")
[sub_resource type="Resource" id="StoryLine_003"]
script = ExtResource("1_storyline")
line_type = "subtitle"
portrait_side = "auto"
inactive_portrait_mode = "dim"
text = "胡承龙大致确认了书的内容"
[sub_resource type="Resource" id="StoryLine_004"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "胡承龙"
text = "哎呀，老先生大作真是让在下佩服，真是古今医书之集大成者锕。"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_005"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "胡老板过奖了，您看什么时候能开始刻板？"
portrait = ExtResource("portrait_2")
[sub_resource type="Resource" id="StoryLine_006"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "胡承龙"
text = "唉，老先生我就跟您实话实说吧。"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_007"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "胡承龙"
text = "您的书确实是医家至宝，可当今世人爱看的是英雄演义，爱情故事，就算发行了恐怕也是卖不出去的。"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_008"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "胡承龙"
text = "再者您这大作洋洋洒洒几百万字，还有大量插图。"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_009"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "胡承龙"
text = "我按市价每百字一钱银子算，再加上油墨，纸张，木料，装订各种费用，初版二十套的发行，我估计要花费两千两白银。"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_010"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "胡承龙"
text = "虽然您这书确实是好书，可我们也不能做亏本买卖不是。"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_011"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "胡承龙"
text = "您老要是想自己掏钱印书，胡某也不是无情无义之人，我不赚钱，给您按最低的成本价给您发行，您看如何？"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_012"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "两千两…我上哪弄两千两银子啊…"
portrait = ExtResource("portrait_2")
[sub_resource type="Resource" id="StoryLine_013"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "胡承龙"
text = "老先生您慢慢考虑，在下就先告辞了。"
portrait = ExtResource("portrait_1")

