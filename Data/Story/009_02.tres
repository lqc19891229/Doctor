[sub_resource type="Resource" id="StoryLine_001"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "李言闻"
text = "东璧回来啦，什么事儿啊，一大早就被叫去了？"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_002"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "朝廷调拨了赈灾药材，这次不光惠民药局，咱们这些医馆药铺也要一起帮忙发放。"
portrait = ExtResource("portrait_2")
[sub_resource type="Resource" id="StoryLine_003"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "right"
inactive_portrait_mode = "dim"
speaker = "吴芷兰"
text = "这几日我去菜市街买菜的时候，看到不少流民在城东，大灾之后必有大疫，朝廷这次赈灾太及时了。"
portrait = ExtResource("portrait_3")
[sub_resource type="Resource" id="StoryLine_004"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "陈皮，跟我去后院收拾收拾库房，一会儿药材就要送来了，得赶紧腾出地方。"
portrait = ExtResource("portrait_2")
[sub_resource type="Resource" id="StoryLine_005"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "陈皮"
text = "好嘞。"
portrait = ExtResource("portrait_4")

