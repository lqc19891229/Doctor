[ext_resource type="Script" path="res://System/Story/StoryLine.gd" id="1_storyline"]
[ext_resource type="Script" path="res://System/Story/StoryData.gd" id="2_storydata"]
[ext_resource type="Texture2D" path="res://Assets/Portrait/StoryNpc/liu_jing_ting/liu_jing_ting.png" id="portrait_1"]
[ext_resource type="Texture2D" path="res://Assets/Portrait/StoryNpc/li_dong_bi/li_dong_bi.png" id="portrait_2"]
[ext_resource type="Texture2D" path="res://Assets/Portrait/StoryNpc/chen_pi/chen_pi.png" id="portrait_3"]
[ext_resource type="Texture2D" path="res://Assets/Portrait/StoryNpc/ban_xia/ban_xia.png" id="portrait_4"]

[sub_resource type="Resource" id="StoryLine_001"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "柳敬亭"
text = "哎呀，舒服多了。"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_002"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "right"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "您这是温燥证，整日说书久坐少动，伤津耗气，易生内热。"
portrait = ExtResource("portrait_2")
[sub_resource type="Resource" id="StoryLine_003"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "right"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "给您开一副桑杏汤，一天三服，也记得多喝水。"
portrait = ExtResource("portrait_2")
[sub_resource type="Resource" id="StoryLine_004"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "陈皮"
text = "柳先生，我最喜欢听您说书啦，您真是啥都知道啥都会，讲什么像什么。"
portrait = ExtResource("portrait_3")
[sub_resource type="Resource" id="StoryLine_005"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "柳敬亭"
text = "诶嘿嘿，小兄弟过奖了，我只是说些王侯将相，才子佳人的故事，来听书的客官喜欢什么，我就讲什么。"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_006"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "陈皮"
text = "先生，您现在就在这讲一段吧。"
portrait = ExtResource("portrait_3")
[sub_resource type="Resource" id="StoryLine_007"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "right"
inactive_portrait_mode = "dim"
speaker = "半夏"
text = "是啊是啊，讲一段吧。"
portrait = ExtResource("portrait_4")
[sub_resource type="Resource" id="StoryLine_008"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "right"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "人家柳先生还病着呢，你们别在这胡闹。"
portrait = ExtResource("portrait_2")
[sub_resource type="Resource" id="StoryLine_009"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "柳敬亭"
text = "无妨，呵呵，那就说一个王道士胡诌妒妇方。"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_010"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "柳敬亭"
text = "说京城有一富商，娶了位善妒的夫人，家中鸡飞狗跳无一日安宁。他的朋友觉得这是病，得找人医治。"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_011"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "柳敬亭"
text = "正巧天齐庙有位摆摊卖膏药的王道士，因膏药灵验得名王一贴，富商的朋友便去求方问药。"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_012"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "柳敬亭"
text = "王一贴道：“这贴妒的膏药倒没经过。有一种汤药，或者可医，只是慢些儿，不能立刻见效的。”"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_013"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "柳敬亭"
text = "朋友问：“什么汤？怎么吃法？”"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_014"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "柳敬亭"
text = "王一贴道：“这叫做‘疗妒汤’。用极好的秋梨一个，二钱冰糖，一钱陈皮，水三碗，梨熟为度。每日清晨吃这一个梨，吃来吃去就好了。”"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_015"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "柳敬亭"
text = "朋友道：“这也不值什么。只怕未必见效。”"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_016"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "柳敬亭"
text = "王一贴道：“一剂不效，吃十剂；今日不效，明日再吃；今年不效，明年再吃。”"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_017"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "柳敬亭"
text = "“横竖这三味药都是润肺开胃不伤人的，甜丝丝的，又止咳嗽，又好吃。吃过一百岁，人横竖是要死的，死了还妒什么？那时就见效了。”"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_018"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "陈皮"
text = "哈哈哈，还有这种方子。"
portrait = ExtResource("portrait_3")
[sub_resource type="Resource" id="StoryLine_019"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "right"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "哈哈哈，这道士说的也不无道理。"
portrait = ExtResource("portrait_2")

