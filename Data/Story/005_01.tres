[sub_resource type="Resource" id="StoryLine_006"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "王府护卫"
text = "奉楚恭王敕令，请先生去王府走一趟。"
portrait = ExtResource("portrait_6")
[sub_resource type="Resource" id="StoryLine_007"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "hide"
speaker = "李东璧"
text = "是什么人病了要我去看病吗？"
portrait = ExtResource("portrait_5")
[sub_resource type="Resource" id="StoryLine_008"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "王府护卫"
text = "事关重大您去了就知道了，马车已经备好了，请先生速速启程。"
portrait = ExtResource("portrait_6")
[sub_resource type="Resource" id="StoryLine_009"]
script = ExtResource("1_storyline")
line_type = "subtitle"
portrait_side = "auto"
inactive_portrait_mode = "dim"
text = "一夜舟车劳顿，李东璧到了楚恭王府。"
[sub_resource type="Resource" id="StoryLine_010"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "楚恭王"
text = "您就是李神医啊，比我想得要年轻许多。请先生来，是小王有事相求。"
portrait = ExtResource("portrait_7")
background = ExtResource("background_8")
[sub_resource type="Resource" id="StoryLine_011"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "草民拜见王爷，有什么我能帮上忙的？"
portrait = ExtResource("portrait_5")
[sub_resource type="Resource" id="StoryLine_012"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "楚恭王"
text = "犬子前几天突然病了，卧床不起。精神萎靡，食欲不振。小王请了好几位大夫，给开了好多方子，都不见好转。眼见着人一天比一天瘦，在这么下去怕是要坏事了…"
portrait = ExtResource("portrait_7")
background = ExtResource("background_9")
[sub_resource type="Resource" id="StoryLine_013"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "楚恭王"
text = "听闻蕲州李先生医术高明，特请先生来给犬子医治。"
portrait = ExtResource("portrait_7")
[sub_resource type="Resource" id="StoryLine_014"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "right"
inactive_portrait_mode = "normal"
speaker = "世子"
text = "咳咳咳，父王…"
portrait = ExtResource("clinic_npc_portrait_1")
[sub_resource type="Resource" id="StoryLine_015"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "hide"
speaker = "楚恭王"
text = "先生，小王就这么一个儿子，请您救救孩子吧。"
portrait = ExtResource("portrait_7")

