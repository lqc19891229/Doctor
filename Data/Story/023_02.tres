[sub_resource type="Resource" id="StoryLine_007"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "王百堂"
text = "先生，刚才那姑娘是得了什么病啊？"
portrait = ExtResource("portrait_4")
[sub_resource type="Resource" id="StoryLine_008"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "right"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "您是？"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_009"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "王百堂"
text = "小生是姑娘的一位相识，担心姑娘身体，来问问大夫。"
portrait = ExtResource("portrait_4")
[sub_resource type="Resource" id="StoryLine_010"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "right"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "哦，那姑娘所患的是肺气虚，并无大碍，只是看起来似乎有心事。您可知其中原委？"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_011"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "半夏"
text = "哎哟？这里面有事儿，快说来听听。"
portrait = ExtResource("portrait_5")
[sub_resource type="Resource" id="StoryLine_012"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "王百堂"
text = "实不相瞒，小生在柳月坊与飞燕相识，一见倾心，私底下定了终身。"
portrait = ExtResource("portrait_4")
[sub_resource type="Resource" id="StoryLine_013"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "王百堂"
text = "原想着凑够五百两白银，给她赎身。可她那老鸨坐地起价一千两，这让我们上哪去凑这么多银子啊…"
portrait = ExtResource("portrait_4")
[sub_resource type="Resource" id="StoryLine_014"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "right"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "想必姑娘是因为这事急坏了身子。"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_015"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "半夏"
text = "唉，又是一对儿苦命的鸳鸯。"
portrait = ExtResource("portrait_5")
[sub_resource type="Resource" id="StoryLine_016"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "吴芷兰"
text = "相公咱想办法帮帮他们吧。"
portrait = ExtResource("portrait_6")
[sub_resource type="Resource" id="StoryLine_017"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "right"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "我也想帮他们，可怎么帮呢？"
