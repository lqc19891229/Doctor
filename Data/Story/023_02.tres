[sub_resource type="Resource" id="StoryLine_001"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "right"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "姑娘这病是肺气虚，平日注意避风避寒，开副补肺汤调养调养。早上练练六字诀中的呬字诀，舒畅胸中气机。"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_002"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "谢飞燕"
text = "…多谢先生。"
portrait = ExtResource("portrait_2")
[sub_resource type="Resource" id="StoryLine_003"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "right"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "姑娘可是有什么心事？"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_004"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "金姨妈"
text = "成天好吃好喝的伺候着，她能有什么心事。"
portrait = ExtResource("portrait_3")
[sub_resource type="Resource" id="StoryLine_005"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "hide"
speaker = "金姨妈"
text = "那就多谢大夫了，走吧女儿。"
portrait = ExtResource("portrait_3")
[sub_resource type="Resource" id="StoryLine_006"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "hide"
speaker = "谢飞燕"
text = "…"
