[sub_resource type="Resource" id="StoryLine_001"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "贾荃"
text = "哎哟，我的头好晕啊。"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_002"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "right"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "贾老板的神志不清是由痰火扰心所致，心情大起大落再加上饮酒过度，使病情加剧。需要戒酒静养，按时服药。"
portrait = ExtResource("portrait_2")
[sub_resource type="Resource" id="StoryLine_003"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "hide"
speaker = "陆忠"
text = "真是太谢谢先生了，老爷我们走吧。"
portrait = ExtResource("portrait_3")
[sub_resource type="Resource" id="StoryLine_004"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "陈皮"
text = "这贾老板怎么突然犯病了呀？我看是这个奸商干坏事儿遭报应了。"
portrait = ExtResource("portrait_4")
[sub_resource type="Resource" id="StoryLine_005"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "right"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "别乱说，快去把他吐的地方收拾收拾，还有病患要看病呢。"
portrait = ExtResource("portrait_2")

