[gd_resource type="Resource" script_class="StoryData" format=3]

[ext_resource type="Script" path="res://System/Story/StoryLine.gd" id="1_storyline"]
[ext_resource type="Script" path="res://System/Story/StoryData.gd" id="2_storydata"]
[ext_resource type="Texture2D" path="res://Assets/Portrait/StoryNpc/li_yan_wen/li_yan_wen.png" id="portrait_1"]
[ext_resource type="Texture2D" path="res://Assets/Portrait/StoryNpc/li_shi_zhen/li_shi_zhen.png" id="portrait_2"]

[sub_resource type="Resource" id="StoryLine_001"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "right"
speaker = "李言闻"
text = "东壁啊，白天教你的都听明白了吗？"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_002"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
speaker = "李东壁"
text = "嗯，都明白了，平常日子里看您治病，其实已经窥探得些门道了。"
portrait = ExtResource("portrait_2")
[sub_resource type="Resource" id="StoryLine_003"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "right"
speaker = "李言闻"
text = "学医最要紧的是积累，吃完晚饭去把这些天教你的内容再看一遍，明日一早你随我一起出诊。"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_004"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
speaker = "李东壁"
text = "哇，太好了！"
portrait = ExtResource("portrait_2")

[resource]
script = ExtResource("2_storydata")
story_id = "002"
trigger_scene = "night"
trigger_day = 1
required_reputation_points = 0
unlock_entry_id = ""
play_once = true
return_scene = "night"
lines = Array[ExtResource("1_storyline")]([SubResource("StoryLine_001"), SubResource("StoryLine_002"), SubResource("StoryLine_003"), SubResource("StoryLine_004")])
