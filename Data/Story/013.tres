[sub_resource type="Resource" id="StoryLine_001"]
script = ExtResource("1_storyline")
line_type = "subtitle"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "雷万钧"
text = "贤弟，好久不见啊，今天来抓点药顺便来看看你。"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_002"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "right"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "雷兄哪里不舒服？"
portrait = ExtResource("portrait_2")
[sub_resource type="Resource" id="StoryLine_003"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "雷万钧"
text = "这次省内各州县的赈灾药材都要从咱们蕲州调拨，我奉命押送，全省各处跑，路上染了点风寒。"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_004"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "right"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "全省都从蕲州调拨？"
portrait = ExtResource("portrait_2")
[sub_resource type="Resource" id="StoryLine_005"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "雷万钧"
text = "是啊，这次的药材统一由蕲州采办存放，哪里缺药就从咱们这调拨。"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_006"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "right"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "有件事儿你知道吗？这次的赈灾药材被人动了手脚，以次充好，根本治不了病。"
portrait = ExtResource("portrait_2")
[sub_resource type="Resource" id="StoryLine_007"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "雷万钧"
text = "什么？有这事儿？"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_008"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "right"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "药剂局的孙大夫去找吴世良理论，被关进大牢，知情的大夫们都不敢声张。"
portrait = ExtResource("portrait_2")
[sub_resource type="Resource" id="StoryLine_009"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "雷万钧"
text = "他娘的，没有王法了！这州府衙门肯定是不能去了，我到武昌府湖广按察司，把这事报上去。"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_010"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "right"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "雷兄这一趟要多加小心啊。"
portrait = ExtResource("portrait_2")

