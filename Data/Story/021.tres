[sub_resource type="Resource" id="StoryLine_001"]
script = ExtResource("1_storyline")
line_type = "subtitle"
portrait_side = "auto"
inactive_portrait_mode = "dim"
music = "res://Assets/Music/Story/021/问斩.mp3"
text = "蕲州赈灾药材贪污案惊动朝廷，锦衣卫奉旨查办，地方涉案官员数十人，贪污银钱近万两。"
background = ExtResource("background_1")
[sub_resource type="Resource" id="StoryLine_002"]
script = ExtResource("1_storyline")
line_type = "subtitle"
portrait_side = "auto"
inactive_portrait_mode = "dim"
text = "主犯吴世良、赵顺等即刻斩首。湖广巡抚陈仕贤等，连坐失察，官降两级。"
[sub_resource type="Resource" id="StoryLine_003"]
script = ExtResource("1_storyline")
line_type = "subtitle"
portrait_side = "auto"
inactive_portrait_mode = "dim"
text = "蕲州所需赈灾药材由太医院调拨，重新发放。"
[sub_resource type="Resource" id="StoryLine_004"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "到头来这吴世良不过是个被推出来顶罪的罢了。"
portrait = ExtResource("portrait_2")
[sub_resource type="Resource" id="StoryLine_005"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "right"
inactive_portrait_mode = "dim"
speaker = "李言闻"
text = "朝政被严党把持，这些做官的你中有我，我中有你，真细究起来又是一笔糊涂账。"
portrait = ExtResource("portrait_3")
[sub_resource type="Resource" id="StoryLine_006"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "楚王"
text = "李先生。"
portrait = ExtResource("portrait_4")
[sub_resource type="Resource" id="StoryLine_007"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "楚王殿下。"
portrait = ExtResource("portrait_2")
[sub_resource type="Resource" id="StoryLine_008"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "楚王"
text = "这次我上奏皇上，除了赈灾药材一案，还将先生举荐给朝廷。正好太医院院判一职空缺，特批先生赴任。"
portrait = ExtResource("portrait_4")
[sub_resource type="Resource" id="StoryLine_009"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "多谢王爷提拔，可草民荆楚鄙人，幼多羸疾，质成钝椎，实在是力不从心。"
portrait = ExtResource("portrait_2")
[sub_resource type="Resource" id="StoryLine_010"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "楚王"
text = "……既然如此，那本王就不强人所难了。"
portrait = ExtResource("portrait_4")

