[sub_resource type="Resource" id="StoryLine_001"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "李言闻"
text = "今天是上元佳节，咱们全家去城里逛逛，听说今年的灯节格外热闹。"
portrait = ExtResource("portrait_1")
background = ExtResource("background_2")
[sub_resource type="Resource" id="StoryLine_002"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "right"
inactive_portrait_mode = "dim"
speaker = "吴芷兰"
text = "太好了，咱们快出发吧。"
portrait = ExtResource("portrait_3")
[sub_resource type="Resource" id="StoryLine_003"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "走。"
portrait = ExtResource("portrait_4")
[sub_resource type="Resource" id="StoryLine_004"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "半夏"
text = "哇，好多人啊！好热闹啊！"
portrait = ExtResource("portrait_5")
background = ExtResource("background_6")
[sub_resource type="Resource" id="StoryLine_005"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "hide"
speaker = "陈皮"
text = "看你那没见过世面的样子。"
portrait = ExtResource("portrait_7")
[sub_resource type="Resource" id="StoryLine_006"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "hide"
speaker = "半夏"
text = "找打，你别跑！"
portrait = ExtResource("portrait_5")
[sub_resource type="Resource" id="StoryLine_007"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "李言闻"
text = "那边好像有唱戏的，咱们去那边看看。"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_008"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "hide"
speaker = "半夏"
text = "夫人，那边有座桥，咱们去走百病！"
portrait = ExtResource("portrait_5")
background = ExtResource("background_8")
[sub_resource type="Resource" id="StoryLine_009"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "hide"
speaker = "吴芷兰"
text = "走，今夜走三桥，一年无灾病。"
portrait = ExtResource("portrait_3")
[sub_resource type="Resource" id="StoryLine_010"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "李言闻"
text = "儿子啊，你和芷兰准备啥时候要孩子啊？"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_011"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "哎哟，爹，您就别操心了。"
portrait = ExtResource("portrait_4")
[sub_resource type="Resource" id="StoryLine_012"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "李言闻"
text = "你们俩一会儿去南门摸摸福气去，听说可灵了。"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_013"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "别说了爹，咱们看戏去吧。"
portrait = ExtResource("portrait_4")
[sub_resource type="Resource" id="StoryLine_014"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "right"
inactive_portrait_mode = "dim"
speaker = "陈皮"
text = "老爷，那边儿在唱紫钗记呢。"
portrait = ExtResource("portrait_7")
[sub_resource type="Resource" id="StoryLine_015"]
script = ExtResource("1_storyline")
line_type = "subtitle"
portrait_side = "auto"
inactive_portrait_mode = "dim"
text = "谢皇恩灯华月华，谢天恩春华岁华，遍写着国泰民安天下，遨头去唱声哗。好灯也，说灯花南天门最佳，香车隘挑笼绛纱，喝道转身停马，尘影里看谁家。"
background = ExtResource("background_9")
[sub_resource type="Resource" id="StoryLine_016"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "right"
inactive_portrait_mode = "dim"
speaker = "吴芷兰"
text = "相公，咱们去猜灯谜吧！"
portrait = ExtResource("portrait_3")
[sub_resource type="Resource" id="StoryLine_017"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "走！"
portrait = ExtResource("portrait_4")
[sub_resource type="Resource" id="StoryLine_018"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "这么多灯谜，\"一点一横长，一撇到南洋，南阳有个人，只有一寸长\"，打一个字…"
portrait = ExtResource("portrait_4")
background = ExtResource("background_10")
[sub_resource type="Resource" id="StoryLine_019"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "right"
inactive_portrait_mode = "dim"
speaker = "吴芷兰"
text = "我知道，这是个\"府\"字。"
portrait = ExtResource("portrait_3")
[sub_resource type="Resource" id="StoryLine_020"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "还是娘子聪慧啊，哈哈。"
portrait = ExtResource("portrait_4")
[sub_resource type="Resource" id="StoryLine_021"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "right"
inactive_portrait_mode = "dim"
speaker = "吴芷兰"
text = "你看这个，\"大雪压青松\"，打一味药材。"
portrait = ExtResource("portrait_3")
[sub_resource type="Resource" id="StoryLine_022"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "这个我会，是\"忍冬\"。"
portrait = ExtResource("portrait_4")
[sub_resource type="Resource" id="StoryLine_023"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "李言闻"
text = "东璧，芷兰，咱们去小摊儿坐会儿吃点元宵。"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_024"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "李言闻"
text = "干了一年坐堂医，感觉怎么样，和你之前想的一样吗？"
portrait = ExtResource("portrait_1")
background = ExtResource("background_11")
[sub_resource type="Resource" id="StoryLine_025"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "我倒是挺喜欢这一行，只是赚不到什么钱，苦了您和芷兰了…"
portrait = ExtResource("portrait_4")
[sub_resource type="Resource" id="StoryLine_026"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "right"
inactive_portrait_mode = "dim"
speaker = "吴芷兰"
text = "只要咱们一家人能一起平平安安的过日子，我就知足了，要那么多钱做什么。"
portrait = ExtResource("portrait_3")
[sub_resource type="Resource" id="StoryLine_027"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "李言闻"
text = "是啊，一家人平平安安就好啊。"
portrait = ExtResource("portrait_1")
[sub_resource type="Resource" id="StoryLine_028"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "李言闻"
text = "好了，不早了，咱们该回家了。"
portrait = ExtResource("portrait_1")

