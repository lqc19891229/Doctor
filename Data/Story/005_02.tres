[sub_resource type="Resource" id="StoryLine_001"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "right"
inactive_portrait_mode = "dim"
speaker = "世子"
text = "父王，我觉得好多了"
portrait = ExtResource("portrait_1")
background = ExtResource("background_2")
[sub_resource type="Resource" id="StoryLine_002"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "世子所患的是脾虚湿盛之证，只要按方每日吃药，病情就无大碍了。"
portrait = ExtResource("portrait_3")
[sub_resource type="Resource" id="StoryLine_003"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "楚王"
text = "先生真是华佗再世，小王无以为报。这一千两白银是我的一点心意，感谢先生救命之恩。"
portrait = ExtResource("portrait_4")
[sub_resource type="Resource" id="StoryLine_004"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "草民行医只取诊费十文，这一千两小人不能收。"
portrait = ExtResource("portrait_3")
[sub_resource type="Resource" id="StoryLine_005"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "right"
inactive_portrait_mode = "dim"
speaker = "陈皮"
text = "少掌柜的那可是一千两白银啊！"
portrait = ExtResource("portrait_5")
[sub_resource type="Resource" id="StoryLine_006"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "left"
inactive_portrait_mode = "dim"
speaker = "李东璧"
text = "世子乃人中龙凤，但无论何人前来看病，草民眼里看到的都只有病人。十文是诊费，绝非世子命价。"
portrait = ExtResource("portrait_3")
[sub_resource type="Resource" id="StoryLine_007"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "楚王"
text = "……先生好风骨，本王平日见的那些儒生满口仁义，可见了真金白银没几个不迷糊的。有您这样的大夫是天下苍生之福啊。"
portrait = ExtResource("portrait_4")
[sub_resource type="Resource" id="StoryLine_008"]
script = ExtResource("1_storyline")
line_type = "dialogue"
portrait_side = "mid"
inactive_portrait_mode = "dim"
speaker = "楚王"
text = "先生的恩情本王记下了，日后有能帮到先生的地方尽管开口。"
portrait = ExtResource("portrait_4")
[sub_resource type="Resource" id="StoryLine_009"]
script = ExtResource("1_storyline")
line_type = "subtitle"
portrait_side = "auto"
inactive_portrait_mode = "dim"
text = "名望+1000"

