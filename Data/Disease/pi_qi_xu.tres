script = ExtResource("1")
disease_id = "pi_qi_xu"
disease_name = "脾气虚"
detail_text = "脾气虚\n\n【病机】饮食劳倦、久病耗伤，脾失健运、中气不足、运化失职。\n\n【症状】食少纳呆、脘腹胀满，饭后尤甚；神疲乏力、少气懒言、肢体倦怠；面色萎黄、形体消瘦或浮肿；大便溏薄\n\n【脉象】\n右关（脾胃，大小肠）：波峰低\n\n【标准方】四君子汤"
recommended_formula_id = "si_jun_zi_tang"
