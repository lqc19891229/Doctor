disease_id = "gan_xue_yu_zhi"
disease_name = "肝血瘀滞"
detail_text = "肝血瘀滞\n\n【病机】肝气失疏，血行凝滞，瘀血痹阻肝之脉络。\n\n【症状】肌肤甲错，周身瘀斑、蛛丝红缕；胁肋刺痛胀满，情绪压抑、生气后疼痛加重。\n\n【脉象】\n左关（肝）：波线粗\n\n【标准方】膈下逐瘀汤"
recommended_formula_id = "ge_xia_zhu_yu_tang"
