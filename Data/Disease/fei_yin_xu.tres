script = ExtResource("1")
disease_id = "fei_yin_xu"
disease_name = "肺阴虚"
detail_text = "肺阴虚\n\n【病机】肺阴亏虚，虚火内生，肺失滋润、清肃无权。\n\n【症状】干咳无痰，或痰少黏稠难咯；咽干口燥、声音嘶哑；潮热盗汗、五心烦热；颧红、形体消瘦。\n\n【脉象】\n右寸（肺）：波速快，波宽窄\n\n【标准方】沙参麦冬汤"
recommended_formula_id = "sha_shen_mai_dong_tang"
