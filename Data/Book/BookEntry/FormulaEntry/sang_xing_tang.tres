[ext_resource type="Script" path="res://System/Book/BookEntry/FormulaBookEntryData.gd" id="1"]

[resource]
script = ExtResource("1")
entry_id = "sang_xing_tang"
book_id = "wen_bing_tiao_bian"
title = "桑杏汤"
detail_text = "桑杏汤\n【出处】《温病条辨》\n【功效】清宣温燥，润肺止咳\n【主治】温燥证\n【组成】\n君：桑叶 一钱五分，杏仁 二钱\n臣：沙参 一钱\n佐：贝母 一钱，淡豆豉 一钱，栀子 一钱，梨皮一钱\n使：\n【配伍】\n桑叶：轻清宣透、疏散上焦温燥\n杏仁：苦润降肺、润燥止咳\n淡豆豉：透表散邪\n贝母：清热化痰、润肺散结\n沙参：养阴生津、润肺\n栀皮：轻清泄上焦燥热\n梨皮：清热润燥、生津止渴"
formula_id = "sang_xing_tang"
