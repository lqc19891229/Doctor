[gd_resource type="Resource" script_class="FormulaBookEntryData" load_steps=2 format=3]

[ext_resource type="Script" path="res://System/Book/BookEntry/FormulaBookEntryData.gd" id="1"]

[resource]
script = ExtResource("1")
entry_id = "gui_zhi_tang"
book_id = "shang_han_lun"
title = "桂枝汤"
detail_text = "桂枝汤\n【出处】《伤寒论》\n【功效】解肌发表，调和营卫\n【主治】风寒表虚证\n【组成】\n君：桂枝 三钱\n臣：白芍 三钱\n佐：生姜 三钱，大枣 二钱\n使：甘草 二钱\n【配伍】\n桂枝辛散卫邪，白芍酸敛营阴；一散一收，调和营卫，不伤正、不敛邪。\n姜枣相合，调和脾胃，化生气血，资营卫之源。"
formula_id = "gui_zhi_tang"
required_herb_ids = Array[String](["gui_zhi", "bai_shao", "sheng_jiang", "da_zao", "gan_cao"])
