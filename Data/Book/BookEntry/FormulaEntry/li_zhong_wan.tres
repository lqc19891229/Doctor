[gd_resource type="Resource" script_class="FormulaBookEntryData" load_steps=2 format=3]

[ext_resource type="Script" path="res://System/Book/BookEntry/FormulaBookEntryData.gd" id="1"]

[resource]
script = ExtResource("1")
entry_id = "li_zhong_wan"
book_id = "shang_han_lun"
title = "理中丸"
detail_text = "理中丸\n\n【出处】\n《伤寒论》\n\n【功效】\n温中祛寒，补气健脾\n\n【主治】\n脾阳虚\n\n【组成】\n君：干姜 五钱\n臣：人参 五钱\n佐：白术 五钱\n使：甘草 五钱\n\n【配伍】\n干姜：大辛大热，温中祛寒、振奋脾阳。\n人参：益气健脾，补益脾胃气虚之本。\n白术：健脾燥湿，助运化、利水湿。\n炙甘草：益气和中、调和诸药，缓急止痛。"
formula_id = "li_zhong_wan"
required_herb_ids = Array[String](["gan_jiang", "ren_shen", "bai_zhu", "gan_cao"])
