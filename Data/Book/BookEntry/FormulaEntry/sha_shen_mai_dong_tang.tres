[resource]
script = ExtResource("1")
entry_id = "sha_shen_mai_dong_tang"
book_id = "wen_bing_tiao_bian"
title = "沙参麦冬汤"
detail_text = "沙参麦冬汤\n【出处】《温病条辩》\n【功效】清养肺胃，生津润燥\n【主治】肺阴虚\n【组成】\n君：沙参 三钱，麦门冬 三钱\n臣：玉竹 二钱，天花粉 一钱五分\n佐：扁豆 一钱五分，桑叶 一钱五分\n使：甘草 一钱\n【配伍】\n沙参、麦冬：养阴润肺、生津止渴，直补肺阴。\n玉竹、天花粉：增强养阴生津、润燥止咳，清虚热、润肺燥。\n桑叶：轻清宣肺、疏散虚热；\n扁豆：健脾养胃，培土生金，助生津之源。\n甘草：调和诸药，益气和中。"
unlock_required_experience_points = -1
formula_id = "sha_shen_mai_dong_tang"
