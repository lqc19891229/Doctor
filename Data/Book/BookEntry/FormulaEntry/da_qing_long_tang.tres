[resource]
script = ExtResource("1")
entry_id = "da_qing_long_tang"
book_id = "shang_han_lun"
title = "大青龙汤"
detail_text = "大青龙汤\n【出处】《伤寒论》\n【功效】发汗解表，兼清里热\n【主治】外寒里热\n【组成】\n君：麻黄 六钱\n臣：桂枝 二钱，石膏 一两\n佐：杏仁 三钱，生姜 三钱，大枣 三钱\n使：甘草 二钱\n【配伍】\n麻黄：发汗峻散，开表散寒，同时宣肺平喘。\n桂枝：助麻黄发汗解表，温通卫阳，散肌表寒邪，解决周身疼痛；\n石膏：辛甘大寒，专清郁于肌腠、肺胃之里热，除烦躁，制约麻黄辛温燥热之性，使发汗而不助热。\n杏仁：降利肺气，配麻黄平喘止咳；\n生姜：辛温，助解表，和胃散水气；\n大枣：补中滋液，防峻汗耗伤津液。\n炙甘草：调和诸药；缓麻黄峻烈之性，护中气；姜枣草合用，滋养营阴，防止大汗伤津。"
formula_id = "da_qing_long_tang"
