script = ExtResource("1")
entry_id = "zhu_ye"
book_id = "shen_nong_ben_cao_jing"
title = "竹叶"
detail_text = "竹叶（竹）\n【气味】味甘、淡，性寒。\n【毒性】无毒。\n【归经】归心、胃、小肠经。\n【主治】清热泻火，除烦，生津利尿。\n【释名】时珍曰︰竹字象形。许慎《说文》云︰“竹，冬生草也”。故字从倒草。戴凯之《竹谱》云︰植物之中，有名曰竹。不刚不柔，非草非木。小异实虚，大同节目。\n\n【发明】\n弘景曰︰甘竹叶最胜。\n\n诜曰︰竹叶︰ 、苦、淡、甘之外，馀皆不堪入药，不宜人。淡竹为上，甘竹次之。\n\n宗奭曰︰诸竹笋性皆微寒，故知其叶一致也。张仲景竹叶汤，惟用淡竹。\n\n元素曰︰竹叶苦平，阴中微阳。\n\n杲曰︰竹叶辛苦寒，可升可降，阳中阴也。其用有二︰除新久风邪之烦热，止喘促气胜"
unlock_required_experience_points = 9
herb_id = "zhu_ye"
