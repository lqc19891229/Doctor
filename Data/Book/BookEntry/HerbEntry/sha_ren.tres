[resource]
script = ExtResource("1")
entry_id = "sha_ren"
book_id = "shen_nong_ben_cao_jing"
title = "砂仁"
detail_text = "砂仁\n【气味】味辛，性温。\n【毒性】无毒。\n【归经】归脾、胃、肾经。\n【主治】化湿开胃，温脾止泻，理气安胎。\n【释名】时珍曰︰名义未详。藕下白 多密，取其密藏之意。此物实在根下，仁藏壳内，亦或此意欤。\n\n【发明】\n时珍曰︰按韩 《医通》云︰肾恶燥，以辛润之。缩砂仁之辛，以润肾燥。又云︰缩砂属土，主醒脾调胃，引诸药归宿丹田。香而能窜，和合五脏冲和之气，如天地以土 为冲和之气，故补肾药用同地黄丸蒸，取其达下之旨也。又化骨，食草木药及方士炼三黄皆用之，不知其性何以能制此物也？"
unlock_required_experience_points = -1
herb_id = "sha_ren"
