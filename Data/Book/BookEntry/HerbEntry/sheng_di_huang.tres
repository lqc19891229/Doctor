script = ExtResource("1")
entry_id = "sheng_di_huang"
book_id = "shen_nong_ben_cao_jing"
title = "生地黄"
detail_text = "生地黄（地黄）\n【气味】味甘、苦，性寒。\n【毒性】无毒。\n【归经】归心、肝、肾经。\n【主治】清热凉血，养阴生津。\n【释名】芐（音户《别录》）、芑（音起《别录》）、地髓（《本经》）。\n\n大明曰︰生者以水浸验之。浮者名天黄；半浮半沉者名人黄；沉者名地黄。入药沉者为佳，半沉者次之，浮者不堪。\n\n时珍曰︰《尔雅》云︰ 芐，地黄。郭璞云︰江东呼为芐。罗愿云︰芐以沉下者为贵，故字从下。\n\n【发明】\n好古曰︰生地黄入手少阴，又为手太阳之剂，故钱仲阳泻丙火与木通同用以导赤也。诸经之血热，与他药相随，亦能治之。溺血、便血皆同。\n\n权曰︰病患虚而多热者，宜加用之。\n\n戴原礼曰︰阴微阳盛，相火炽强，来乘阴位，日渐煎熬，为虚火之证者，宜地黄之属，以滋阴退阳。\n\n宗奭曰︰《本经》只言干、生二种，不言熟者。如血虚劳热，产后虚热，老人中虚燥热者，若与生干，当虑太寒，故后世改用蒸曝熟者。生熟之功殊别，不可不详。\n\n时珍曰︰《本经》所谓干地黄者，乃阴干、日干、火干者，故又云生者尤良。《别录》复云生地黄者，乃新掘鲜者，故其性大寒。其熟地黄乃后人复蒸晒者。诸家本草皆指干地黄为熟地黄，虽主治证同，而凉血、补血之功稍异，故今别出熟地黄一条于下。"
unlock_required_experience_points = -1
herb_id = "sheng_di_huang"
