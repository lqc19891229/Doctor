[resource]
script = ExtResource("1")
entry_id = "bian_dou"
book_id = "shen_nong_ben_cao_jing"
title = "扁豆"
detail_text = "扁豆（藊豆）\n【气味】味甘，性微温。\n【毒性】无毒。\n【归经】归脾、胃经。\n【主治】健脾化湿，和中消暑。\n【释名】沿篱豆（俗）、蛾眉豆（《纲目》）。\n\n时珍曰︰ 藊本作扁，荚形扁也。沿篱，蔓延也。蛾眉，象豆脊白路之形也。\n\n【发明】\n时珍曰︰硬壳白扁豆，其子充实，白而微黄，其气腥香，其性温平，得乎中和，脾之谷也。入太阴气分，通利三焦，能化清降浊，故专治中宫之病，消暑除湿而解毒也。其软壳及黑鹊色者，其性微凉，但可供食，亦调脾胃。"
unlock_required_experience_points = 44
herb_id = "bian_dou"
