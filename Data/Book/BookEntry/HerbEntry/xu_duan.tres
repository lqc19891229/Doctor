[resource]
script = ExtResource("1")
entry_id = "xu_duan"
book_id = "shen_nong_ben_cao_jing"
title = "续断"
detail_text = "续断\n【气味】味苦、辛，性微温。\n【毒性】无毒\n【归经】归肝、肾经。\n【主治】肝肾亏虚，冲任不固之崩漏，胎漏、胎动不安。\n【释名】属折（《本经》）、接骨（《别录》）、龙豆（《本经》）、南草（《别录》）。\n\n时珍曰︰续断、属折、接骨，皆以功命名也。\n\n【发明】\n时珍曰︰宋张叔潜秘书，知剑州时，其阁下病血痢。一医用平胃散一两，入川续断末二钱半。每服二钱，水煎服即愈。绍兴壬子，会稽时行痢疾。叔潜之子以方传人，往往有验。小儿痢服之效。"
unlock_required_experience_points = 104
herb_id = "xu_duan"
