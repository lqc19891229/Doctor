script = ExtResource("1")
entry_id = "niu_bang_zi"
book_id = "shen_nong_bai_cao_jing"
title = "牛蒡子"
detail_text = "牛蒡子（恶实）\n\n【气味】\n味辛、苦，性寒\n\n【毒性】\n无毒\n\n【归经】\n归肺、胃经\n\n【主治】\n疏散风热\n宣肺透疹\n解毒利咽\n滑肠通便\n\n【释名】\n鼠粘（《别录》）、牛蒡（《别录》）、大力子（《纲目》）、蒡翁菜（《纲目》）、便牵牛（《纲目》）、蝙蝠刺。\n\n时珍曰︰其实状恶而多刺钩，故名也。其根叶皆可食，人呼为牛菜，术人隐之呼为大力也。俚人谓之便牵牛。河南人呼为夜叉头。\n颂曰︰实壳多刺，鼠过之则缀惹不可脱，故谓之鼠粘子，亦如羊负来之比。\n\n【发明】\n杲曰︰鼠粘子其用有四︰治风湿瘾疹，咽喉风热，散诸肿疮疡之毒，利凝滞腰 膝之气，是也。"
herb_id = "niu_bang_zi"
