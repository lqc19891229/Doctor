script = ExtResource("1")
entry_id = "zi_wan"
book_id = "shen_nong_ben_cao_jing"
title = "紫菀"
detail_text = "紫菀\n【气味】味辛、苦，性温。\n【毒性】无毒。\n【归经】归肺经。\n【主治】润肺下气，化痰止咳。\n【释名】青菀（《别录》）、紫蒨（《别录》）、返魂草（《纲目》）、夜牵牛（《斗门方》）。\n\n时珍曰︰其根色紫而柔宛，故名许慎《说文》作茈菀。《斗门方》谓之返魂草。\n\n【发明】"
herb_id = "zi_wan"
