[resource]
script = ExtResource("1")
entry_id = "long_gu"
book_id = "shen_nong_ben_cao_jing"
title = "龙骨"
detail_text = "龙骨\n【气味】甘、涩，平。\n【毒性】无毒。\n【归经】归心、肝、肾经。\n【主治】镇惊安神，平肝潜阳，收敛固涩，收湿敛疮。\n【释名】时珍曰︰按许慎《说文》︰龙字篆文象形。《生肖论》云︰龙耳亏聪，故谓之龙。梵书名那伽。\n\n【发明】\n敩曰︰气入丈夫肾脏中，故益肾药宜用之。\n\n时珍曰︰涩可去脱。故成氏云︰龙骨能收敛浮越之正气，固大肠而镇惊。又主带脉为病。"
herb_id = "long_gu"
