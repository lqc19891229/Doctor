book_id = "zhu_bing_yuan_hou_lun"
title = "肺热壅盛"
detail_text = "肺热壅盛\n\n【病机】邪热壅滞于肺，肺失宣降，气机闭塞，热盛气逆\n\n【症状】咳嗽气粗、喘促胸闷；痰黄黏稠、不易咳出；发热、口渴咽痛；鼻翼煽动，大便偏干，小便黄。\n\n【脉象】\n右寸（肺）：波速快\n\n【标准方】麻杏石甘汤"
unlock_required_experience_points = -1
