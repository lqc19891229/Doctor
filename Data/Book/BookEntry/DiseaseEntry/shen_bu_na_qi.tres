[resource]
script = ExtResource("1")
entry_id = "shen_bu_na_qi"
book_id = "zhu_bing_yuan_hou_lun"
title = "肾不纳气"
detail_text = "肾不纳气\n\n【病机】久病咳喘、年老肾虚、劳伤肾气；肾气亏虚，下元不固，不能摄纳肺气，气浮于上。属虚喘、肺肾两虚，无明显实邪。\n\n【症状】喘促日久、呼多吸少、动则喘甚；气短不足以息、吸气浅表；腰膝酸软、神疲乏力；或自汗、语声低怯\n\n【脉象】\n右寸（肺）：波峰低\n右尺（肾阳）：波峰低\n\n【标准方】人参蛤蚧散"
disease_id = "shen_bu_na_qi"
prerequisite_entry_ids = Array[String](["ren_shen_ge_jie_san"])
