[ext_resource type="Script" path="res://System/Book/BookEntry/DiseaseBookEntryData.gd" id="1"]

[resource]
script = ExtResource("1")
entry_id = "shen_jing_bu_zu"
book_id = "zhu_bing_yuan_hou_lun"
title = "肾精不足"
detail_text = "肾精不足\n\n【病机】先天禀赋不足、后天耗伤太过、久病及肾、房劳过度，肾精亏少，不能充养骨骼、脑髓、生殖之本。\n\n【症状】小儿五迟五软：立迟、行迟、语迟、发迟、齿迟；囟门迟闭、智力低下、身材矮小\n成人脑髓失养：头晕耳鸣、健忘失眠、精神迟钝；早衰特征：发脱齿摇、须发早白；骨骼失养：腰膝酸软、足痿无力生殖亏虚：男子精少不育；女子经闭、不孕\n\n【脉象】\n左尺（肾阴）：波线细\n右尺（肾阳）：波峰低\n\n【标准方】左归丸"
disease_id = "shen_jing_bu_zu"
prerequisite_entry_ids = Array[String](["zuo_gui_wan"])
