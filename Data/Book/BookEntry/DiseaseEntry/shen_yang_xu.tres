[ext_resource type="Script" path="res://System/Book/BookEntry/DiseaseBookEntryData.gd" id="1"]

[resource]
script = ExtResource("1")
entry_id = "shen_yang_xu"
book_id = "zhu_bing_yuan_hou_lun"
title = "肾阳虚"
detail_text = "肾阳虚\n\n【病机】年老肾亏、久病伤阳、房劳耗损，肾阳亏虚、命门火衰、温煦气化无权。\n\n【症状】腰膝冷痛、酸软无力；畏寒肢冷，尤以下肢为甚；精神萎靡、面色㿠白或黧黑；小便清长、夜尿多、遗尿；男子阳痿早泄，女子宫寒不孕、带下清稀；大便久泄不止、完谷不化、五更泄泻\n\n【脉象】\n左尺（肾阴）：波宽宽\n右尺（肾阳）：波峰低，波速慢\n\n【标准方】金匮肾气丸"
disease_id = "shen_yang_xu"
prerequisite_entry_ids = Array[String](["jin_gui_shen_qi_wan"])
