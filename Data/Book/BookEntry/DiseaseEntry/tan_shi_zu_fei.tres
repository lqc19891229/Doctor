[resource]
script = ExtResource("1")
entry_id = "tan_shi_zu_fei"
book_id = "zhu_bing_yuan_hou_lun"
title = "痰湿阻肺"
detail_text = "痰湿阻肺\n\n【病机】脾失健运，痰湿内生，上壅于肺，肺失宣降。\n\n【症状】咳嗽痰多，色白黏稠、量多易咯；胸闷、气喘、喉间痰鸣；肢体困重，口淡不渴\n\n【脉象】\n右寸（肺）：波宽宽\n\n【标准方】二陈汤"
disease_id = "tan_shi_zu_fei"
prerequisite_entry_ids = Array[String](["er_chen_tang"])
