[resource]
script = ExtResource("1")
entry_id = "xing_bi"
book_id = "zhu_bing_yuan_hou_lun"
title = "行痹"
detail_text = "行痹（风痹）\n\n【病机】\n风寒湿邪侵袭经络，以风邪偏盛为主。风性善行、走窜不定。\n\n【症状】\n肢体关节酸痛，疼痛游走不定，窜走周身。\n\n【脉象】\n浮脉（表）：波峰高（最明显），波速慢，波宽宽\n\n【标准方】\n防风汤"
disease_id = "xing_bi"
prerequisite_entry_ids = Array[String](["fang_feng_tang"])
