[resource]
script = ExtResource("1")
entry_id = "gan"
book_id = "huang_di_nei_jing"
title = "肝"
sort_index = 9
detail_text = "【肝】\n\n肝是五脏之一，在五行属木，与胆相表里。中医认为肝具有主疏泄和藏血的功能。主疏泄是指肝能够调畅全身气机，促进脾胃运化、胆汁排泄和情志活动；藏血是指肝能够贮藏血液，并根据人体活动和休息的需要调节血量。\n\n肝在体合筋，其华在爪，开窍于目，在志为怒，在液为泪。肝血充足时，筋脉得到濡养，肢体活动灵活，双目视物清晰，指甲坚韧润泽。若肝血不足，可能出现视物模糊、肢体麻木、筋脉拘急或指甲失养等表现。\n\n肝的疏泄功能失常，可见情志抑郁、急躁易怒、胸胁胀满、食欲不振等表现；肝阳偏亢或肝火上炎，则可能出现头晕、头痛、面红目赤等表现。判断肝的功能状态，需要结合气血阴阳及其他脏腑情况综合分析。"
unlock_required_experience_points = 60
