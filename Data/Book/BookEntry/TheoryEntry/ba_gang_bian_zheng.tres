[resource]
script = ExtResource("1")
entry_id = "ba_gang_bian_zheng"
book_id = "huang_di_nei_jing"
title = "八纲辨证"
sort_index = 6
detail_text = "【八纲辨证】\n\n八纲辨证是中医分析病情的基本方法。医者通过望、闻、问、切收集症状，再以阴、阳、表、里、寒、热、虚、实八项纲领进行归纳，从而判断疾病的位置、性质以及正邪力量的盛衰。\n\n表里：辨别病位的内外深浅。病在肌表、经络，多属表；病入脏腑、气血，多属里。\n\n寒热：辨别疾病的性质。寒证多见畏寒喜暖、口淡不渴；热证多见发热喜凉、口渴烦躁。\n\n虚实：辨别正邪盛衰。虚证多为正气不足、功能衰弱；实证多为邪气较盛、病理产物壅滞。\n\n阴阳：统摄其余六纲，是八纲的总纲。一般而言，表、热、实偏属阳，里、寒、虚偏属阴。\n\n八纲之间并非彼此孤立，一种病证可以同时具有多种性质，如表寒证、里热证或虚寒证。病情发展过程中，还可能发生表里出入、寒热转化和虚实变化。因此，医者必须四诊合参，方能把握疾病的整体情况。"
unlock_required_experience_points = 10
