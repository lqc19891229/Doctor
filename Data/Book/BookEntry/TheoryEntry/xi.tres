[resource]
script = ExtResource("1")
entry_id = "xi"
book_id = "huang_di_nei_jing"
title = "喜"
sort_index = 26
detail_text = "【喜】\n\n喜是七情之一，是人在愿望得到满足或遇到愉快事物时产生的正常情绪。适度的喜悦能够使心情舒畅、气血和缓，对身心具有积极作用。中医认为喜与心相应，正常的喜悦有助于心气调畅。\n\n喜悦过度或突然大喜时，则可能使心气涣散、心神失守，称为“喜则气缓”。这里的“缓”既有气机舒缓的一面，也包含过度时气机弛缓、精神难以集中的含义。\n\n过喜伤心时，可能出现心悸、失眠、精神涣散、注意力不集中或情绪异常兴奋等表现；情况严重时，还可能出现神志恍惚。判断是否由喜伤心，需要结合情绪变化、心神表现及个人体质综合分析。"
unlock_required_experience_points = 80
