[ext_resource type="Script" path="res://System/Book/BookEntry/TheoryBookEntryData.gd" id="1"]

[resource]
script = ExtResource("1")
entry_id = "xue"
book_id = "huang_di_nei_jing"
title = "血"
sort_index = 15
detail_text = "【血】\n\n血是中医所说运行于脉中、具有濡养和滋润作用的红色液态物质，也是维持人体生命活动的重要基础。血主要由脾胃运化所得的水谷精微化生，并与营气、津液及肾精的作用密切相关。\n\n血在心气推动下循脉运行，由肝贮藏和调节，并依靠脾气固摄而不致逸出脉外。血能够濡养脏腑、经络、肌肉、皮肤和官窍，同时也是精神意识活动的重要物质基础。血液充足、运行通畅时，面色润泽，感觉和运动正常，精神安定。\n\n血液不足可形成血虚，常见面色淡白、头晕、心悸、肢体麻木等表现；血行不畅可形成血瘀，常见固定刺痛、肿块或面色晦暗；血热、血寒及血液逸出脉外，也会形成不同证候。判断血的状态，需要结合气、津液和相关脏腑功能综合分析。"
unlock_required_experience_points = 60
