[resource]
script = ExtResource("1")
entry_id = "ba_mai"
book_id = "huang_di_nei_jing"
title = "把脉"
detail_text = "游戏中人体被划分为表、心、肝、脾、肺、肾六个区域；每个区域由气、血、寒热、湿燥四种属性构成；医者通过把脉确定病位和病性。\n\n【寸关尺】\n寸、关、尺是脉诊中的三个把脉位置，在手腕桡骨动脉上。医者通过按压这三个位置，感受脉象的强弱、快慢、沉浮、流畅程度，从而推测人体不同区域和脏腑的健康状况。\n\n【对应脏腑区域】\n浮脉：表\n左寸：心\n左关：肝\n左尺：肾阴\n右寸：肺\n右关：脾\n右尺：肾阳\n\n【脉象】\n游戏中脉象由波形图表示。\n\n波峰的高低反应气的强弱；\n波峰越高气滞程度越高，波峰越低气虚程度越高。\n\n波线的粗细反应血的状态；\n波线越粗血瘀程度越高，波线越细血虚程度越高。\n\n波宽的宽窄反应湿燥程度；\n波宽越宽越湿，波宽越窄越燥。\n\n波速的快慢反应寒热程度；\n波速越快越热，波速越慢越寒。"
prerequisite_entry_ids = Array[String]([])
