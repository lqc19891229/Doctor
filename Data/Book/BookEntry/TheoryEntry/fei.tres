[resource]
script = ExtResource("1")
entry_id = "fei"
book_id = "huang_di_nei_jing"
title = "肺"
sort_index = 16
detail_text = "【肺】\n\n肺是五脏之一，在五行属金，与大肠相表里。中医认为肺具有主气、司呼吸、主宣发肃降和通调水道的功能。肺吸入自然界的清气，并参与宗气的生成；宣发使气和津液向上、向外输布，肃降使气和津液向下运行，并维持呼吸通畅。\n\n肺在体合皮，其华在毛，开窍于鼻，在志为悲忧，在液为涕。肺气充足时，呼吸均匀，声音有力，皮肤和毛发得到濡养，人体抵御外邪的能力正常。若肺气不足，可能出现气短、咳嗽、声音低弱、自汗和容易感受外邪等表现。\n\n肺失宣降时，可见咳嗽、气喘、鼻塞或痰液增多；肺的通调水道功能失常，还可能出现水液停聚、小便不利或水肿等表现。判断肺的功能状态，需要结合呼吸、声音、皮毛、鼻窍和水液代谢情况综合分析。"
unlock_required_experience_points = 40
