[resource]
script = ExtResource("1")
entry_id = "feng_xie"
book_id = "huang_di_nei_jing"
title = "风邪"
sort_index = 19
detail_text = "【风邪】\n\n风邪是外感六邪之一，在五行与春季相应，但其他季节也可出现。中医认为风为阳邪，性质轻扬开泄，容易侵袭人体上部、肌表和肺卫，因此风邪致病多见头面部及体表症状。\n\n风邪具有善行数变的特点。“善行”是指症状位置游走不定，如游走性关节疼痛；“数变”是指发病较急、症状变化较快。风邪还具有主动的特点，可能出现眩晕、震颤、抽搐或肢体活动异常等表现。\n\n风邪常见恶风、发热、头痛、鼻塞、咳嗽、汗出、皮肤瘙痒等表现。由于风邪容易与其他邪气结合，又被称为“百病之长”，临床上常见风寒、风热、风湿和风燥等不同证候。"
unlock_required_experience_points = 80
