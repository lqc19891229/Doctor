[resource]
script = ExtResource("1")
entry_id = "pi"
book_id = "huang_di_nei_jing"
title = "脾"
sort_index = 11
detail_text = "【脾】\n\n脾是五脏之一，在五行属土，与胃相表里。中医认为脾具有主运化、升清和统血的功能。主运化是指脾将饮食物转化为水谷精微，并输布至全身；升清是指将精微物质向上输送；统血是指脾气能够固摄血液，使其正常运行于脉中。\n\n脾在体合肉，主四肢，其华在唇，开窍于口，在志为思，在液为涎。脾气健运时，饮食消化正常，肌肉充实，四肢有力，口唇红润。若脾失健运，可能出现食欲不振、腹胀、便溏、身体困重、四肢乏力等表现。\n\n脾气不足可导致水谷精微化生不足，也可能使水湿停聚，形成痰湿；脾不统血时，则可能出现便血、皮下出血或女性月经过多等表现。判断脾的功能状态，需要结合胃的受纳、气血生成和水液代谢情况综合分析。"
unlock_required_experience_points = 60
