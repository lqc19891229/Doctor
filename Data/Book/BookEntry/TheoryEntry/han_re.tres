[resource]
script = ExtResource("1")
entry_id = "han_re"
book_id = "huang_di_nei_jing"
title = "寒热"
sort_index = 9
detail_text = "【寒热】\n\n寒热是中医八纲辨证中用来判断疾病性质的两项纲领。寒证多由寒邪侵袭，或人体阳气不足所致；热证多由热邪侵袭、阳气偏盛，或阴液不足所致。这里的寒热并不只指体温高低，而是对患者整体表现的综合判断。\n\n寒证：常见畏寒喜暖、四肢发冷、面色苍白、口淡不渴、小便清长、大便稀溏、舌淡苔白、脉象迟缓等表现。\n\n热证：常见发热喜凉、面红烦躁、口渴喜冷饮、小便短黄、大便干结、舌红苔黄、脉象较数等表现。\n\n寒证又可分为实寒与虚寒，热证也可分为实热与虚热。医者需要结合表里、虚实以及望、闻、问、切所得信息进行判断，不可只凭一个症状确定寒热。辨明疾病性质后，通常遵循寒证用温法、热证用清法的基本方向。"
unlock_required_experience_points = 10
