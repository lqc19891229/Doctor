[resource]
script = ExtResource("1")
entry_id = "xin"
book_id = "huang_di_nei_jing"
title = "心"
sort_index = 10
detail_text = "【心】\n\n心是五脏之一，在五行属火，与小肠相表里。中医认为心具有主血脉和藏神的功能。主血脉是指心气推动血液在脉中运行，以濡养全身；藏神是指心与人的精神、意识、思维、情志和睡眠等活动密切相关。\n\n心在体合脉，其华在面，开窍于舌，在志为喜，在液为汗。心气和心血充足时，血脉运行通畅，面色红润，精神充沛，意识清楚，语言表达正常。若心血不足或心神失养，可能出现心悸、失眠、多梦、健忘、面色少华等表现。\n\n心气不足或心阳不振，可见心悸气短、精神疲倦、畏寒肢冷等表现；心火偏盛，则可能出现心烦失眠、口舌生疮、舌尖红等表现。判断心的功能状态，需要结合血脉、神志、舌象和脉象综合分析。"
unlock_required_experience_points = 40
