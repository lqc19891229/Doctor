[resource]
script = ExtResource("1")
entry_id = "zang_xiang"
book_id = "huang_di_nei_jing"
title = "藏象"
detail_text = "【藏象】\n\n藏象是中医研究人体脏腑生理功能、病理变化及其相互关系的理论。“藏”指藏于体内的脏腑，“象”指脏腑功能表现于外的各种征象。中医通过观察人的面色、形体、情志、声音、舌象和脉象等外在变化，推断脏腑的功能状态。\n\n藏象学说将人体内脏分为五脏、六腑和奇恒之腑。五脏包括肝、心、脾、肺、肾，以化生和贮藏精气为主要特点；六腑包括胆、小肠、胃、大肠、膀胱、三焦，以受盛和传化水谷为主要特点。奇恒之腑包括脑、髓、骨、脉、胆和女子胞。\n\n藏象理论强调人体是一个相互联系的整体。各脏腑不仅具有各自的功能，还通过气血津液、经络以及五行生克关系彼此协调，并与形体、官窍、情志和自然环境相联系。中医所说的脏腑属于功能体系，不能与现代医学中的解剖器官完全等同。"
unlock_required_experience_points = 40
