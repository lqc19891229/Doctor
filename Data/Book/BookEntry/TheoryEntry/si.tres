[resource]
script = ExtResource("1")
entry_id = "si"
book_id = "huang_di_nei_jing"
title = "思"
sort_index = 29
detail_text = "【思】\n\n思是七情之一，主要指思考、谋虑和注意力集中的精神活动。正常思考有助于学习和处理问题，但思虑过度、长期用脑或反复纠结同一件事，则可能影响人体气机。\n\n中医认为思与脾相应。思虑过度容易使气机郁结，称为“思则气结”，并可能影响脾的运化功能，使饮食物不能正常转化为气血津液。\n\n思伤脾时，常见食欲不振、腹胀、便溏、身体乏力、精神倦怠等表现；心脾同时受到影响时，还可能出现心悸、健忘、失眠、多梦等症状。判断时需要结合饮食、睡眠和精神状态综合分析。"
unlock_required_experience_points = 80
