[resource]
script = ExtResource("1")
entry_id = "shen"
book_id = "huang_di_nei_jing"
title = "肾"
sort_index = 17
detail_text = "【肾】\n\n肾是五脏之一，在五行属水，与膀胱相表里。中医认为肾具有藏精、主生长发育与生殖、主水和主纳气的功能。肾精是人体生长、发育和生殖的重要物质基础；肾主水，是指肾参与调节全身水液代谢；肾主纳气，是指肾能够帮助肺维持呼吸的深度和稳定。\n\n肾在体合骨，生髓充脑，其华在发，开窍于耳及二阴，在志为恐，在液为唾。肾精充足时，骨骼坚固，牙齿强健，听觉正常，头发有光泽，生长发育和生殖功能正常。若肾精不足，可能出现腰膝酸软、耳鸣、健忘、牙齿松动或生长发育迟缓等表现。\n\n肾阳不足可见畏寒肢冷、水肿、夜尿增多等表现；肾阴不足则可能出现潮热盗汗、口咽干燥、头晕耳鸣等表现；肾不纳气时，可见呼吸短促、动则气喘等表现。判断肾的功能状态，需要结合精、气、阴、阳以及水液代谢情况综合分析。"
unlock_required_experience_points = 40
