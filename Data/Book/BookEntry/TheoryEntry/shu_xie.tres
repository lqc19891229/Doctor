[resource]
script = ExtResource("1")
entry_id = "shu_xie"
book_id = "huang_di_nei_jing"
title = "署邪"
sort_index = 21
detail_text = "【暑邪】\n\n暑邪是外感六邪之一，是夏季特有的致病邪气，多由天气炎热、长时间暴露于高温环境或劳作过度所致。中医认为暑为阳邪，性质炎热升散，容易使人体腠理开泄、汗液大量排出。\n\n暑邪容易耗气伤津，常见高热、面红、心烦、口渴、大量出汗、身体乏力、气短、小便短黄等表现。暑邪严重时还可能出现头晕、恶心、突然昏倒或意识异常等情况。\n\n暑季气候往往炎热而潮湿，因此暑邪常与湿邪同时侵袭人体，形成“暑湿”。除发热口渴外，还可见胸闷、恶心、食欲不振、身体困重、腹泻和舌苔腻等表现。辨治时需要根据暑热与湿邪所占比重分别判断。"
unlock_required_experience_points = 60
