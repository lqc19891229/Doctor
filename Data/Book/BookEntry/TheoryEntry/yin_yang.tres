[ext_resource type="Script" path="res://System/Book/BookEntry/TheoryBookEntryData.gd" id="1"]

[resource]
script = ExtResource("1")
entry_id = "yin_yang"
book_id = "huang_di_nei_jing"
title = "阴阳"
sort_index = 3
detail_text = "【阴阳】\n\n阴阳是中医认识人体与自然变化的基本方法。阴代表相对安静、寒凉、内守的一面，阳代表相对活动、温热、外发的一面。二者相互对立，又彼此依存，并会随着时间与环境不断消长变化。\n\n人体中的寒热、表里、虚实、动静，都可以用阴阳来概括。阴阳保持协调，身体便能正常运行；若一方偏盛或偏衰，就可能出现疾病。医者诊病时，需要分辨阴阳变化，判断失衡所在，再采用相应的方法使其重新趋于协调。"
unlock_required_experience_points = 10
