[resource]
script = ExtResource("1")
entry_id = "kong"
book_id = "huang_di_nei_jing"
title = "恐"
sort_index = 31
detail_text = "【恐】\n\n恐是七情之一，是人在面临危险、威胁或未知事物时产生的害怕情绪。适度恐惧能够使人提高警觉、躲避危险，但长期处于恐惧之中或突然受到强烈惊吓，则可能扰乱脏腑气机。\n\n中医认为恐与肾相应。恐惧过度容易使肾气不固、气机下陷，称为“恐则气下”，从而影响肾的封藏及对二便的固摄功能。\n\n恐伤肾时，可能出现腰膝酸软、精神不安、遗尿、尿失禁或二便异常等表现；长期恐惧还可能耗伤肾精，使人出现健忘、耳鸣和意志消沉等症状。判断时需要结合恐惧发生的原因、持续时间及肾的相关表现综合分析。"
unlock_required_experience_points = 100
