[resource]
script = ExtResource("1")
entry_id = "jin"
book_id = "huang_di_nei_jing"
title = "津"
sort_index = 20
detail_text = "【津】\n\n津是人体正常水液的一部分，与液合称“津液”。中医认为津的性质较为清稀、流动性较强，主要分布于皮肤、肌肉和孔窍，也可渗入血脉，参与血液的组成和运行。\n\n津具有滋润皮肤、肌肉、口鼻和其他官窍的作用，并参与汗液、尿液等的生成和排泄。津的输布与脾的运化、肺的宣发肃降、肾的气化以及三焦水道是否通畅密切相关。\n\n津液不足时，常见口渴、口鼻干燥、皮肤干涩、小便短少或大便干结等表现；津的输布和排泄失常时，则可能停聚为水湿、痰饮或形成水肿。津和液性质有所不同，但能够相互转化，临床上通常结合起来判断。"
unlock_required_experience_points = 40
