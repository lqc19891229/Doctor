[resource]
script = ExtResource("1")
entry_id = "zao_xie"
book_id = "huang_di_nei_jing"
title = "燥邪"
detail_text = "【燥邪】\n\n燥邪是外感六邪之一，在五行与秋季相应，常见于气候干燥或人体津液不足以适应环境变化时。中医认为燥邪性质干涩，最容易耗伤人体津液，并容易侵袭肺脏。\n\n燥邪损伤津液后，常见口鼻干燥、咽干口渴、皮肤干涩、毛发失润、大便干结、小便短少等表现。肺为娇脏，喜润恶燥，因此燥邪犯肺时还可能出现干咳少痰，或痰液黏稠、不易咳出等表现。\n\n燥邪可分为温燥与凉燥。温燥多带有热象，可见发热、微恶风、口渴等表现；凉燥多带有寒象，可见恶寒、头痛、无汗等表现。医者需要结合季节、寒热和津液受损程度综合判断。"
unlock_required_experience_points = 60
