[resource]
script = ExtResource("1")
entry_id = "jing"
book_id = "huang_di_nei_jing"
title = "惊"
sort_index = 36
detail_text = "【惊】\n\n惊是七情之一，是人在突然遇到意外、声响或危险时产生的急剧情绪反应。惊与恐有所不同：惊通常由突发刺激引起，事先没有心理准备；恐则多是对已知或预期危险产生的害怕。\n\n中医认为惊主要影响心神，可使气机紊乱，称为“惊则气乱”。受到突然惊吓后，心神失去安定，气血运行也可能暂时失常，并可进一步影响肾的封藏功能。\n\n惊伤心神时，常见心悸、失眠、神志不宁、精神恍惚、容易受惊或注意力难以集中等表现；情况严重时，还可能出现昏厥或神志异常。判断时需要结合刺激强度、持续影响及患者原有的身心状态综合分析。"
unlock_required_experience_points = 80
