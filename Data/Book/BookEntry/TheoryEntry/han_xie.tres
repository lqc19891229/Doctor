[ext_resource type="Script" path="res://System/Book/BookEntry/TheoryBookEntryData.gd" id="1"]

[resource]
script = ExtResource("1")
entry_id = "han_xie"
book_id = "huang_di_nei_jing"
title = "寒邪"
sort_index = 20
detail_text = "【寒邪】\n\n寒邪是外感六邪之一，在五行与冬季相应，气温骤降、衣着不足或长时间处于寒冷环境时较易侵袭人体。中医认为寒为阴邪，容易损伤人体阳气，使温煦和推动功能受到影响。\n\n寒邪具有凝滞和收引的特点。凝滞是指寒邪可使气血运行不畅，容易引起较为明显的疼痛；收引是指寒邪可使腠理、筋脉和经络收缩，出现无汗、肢体拘急、关节屈伸不利等表现。\n\n寒邪侵袭肌表时，常见恶寒明显、发热较轻、无汗、头痛身痛、鼻流清涕、舌苔薄白、脉浮紧等表现；寒邪深入脏腑时，则可能出现脘腹冷痛、呕吐、腹泻或四肢发冷等表现。辨治时还需区分外寒、内寒以及寒邪所在部位。"
unlock_required_experience_points = 60
