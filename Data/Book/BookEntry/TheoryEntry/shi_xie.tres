[resource]
script = ExtResource("1")
entry_id = "shi_xie"
book_id = "huang_di_nei_jing"
title = "湿邪"
detail_text = "【湿邪】\n\n湿邪是外感六邪之一，在五行与长夏相应，常与气候潮湿、淋雨涉水或长期处于湿润环境有关。中医认为湿为阴邪，容易阻碍气机、损伤阳气，并与脾的运化功能关系密切。\n\n湿邪具有重浊、黏滞和趋下的特点。重浊是指患者常有身体沉重、头重如裹、四肢困倦等感觉；黏滞是指症状缠绵、病程较长、分泌物黏腻不爽；趋下是指湿邪引起的症状较易出现在人体下部。\n\n湿邪致病常见胸闷脘痞、食欲不振、恶心、腹胀、便溏、肢体沉重、关节酸痛、舌苔厚腻等表现。湿邪还常与风、寒、热等邪气结合，形成风湿、寒湿或湿热等不同证候。"
unlock_required_experience_points = 60
