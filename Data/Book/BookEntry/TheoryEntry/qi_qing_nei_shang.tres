[resource]
script = ExtResource("1")
entry_id = "qi_qing_nei_shang"
book_id = "huang_di_nei_jing"
title = "七情内伤"
sort_index = 29
detail_text = "【七情内伤】\n\n七情内伤是中医对喜、怒、忧、思、悲、恐、惊七种情志活动引起疾病的概括。七情原本是人体对外界事物产生的正常情绪反应，一般不会致病；当情绪过于强烈、突然发生或持续时间过长，超过人体自身的调节能力时，便可能影响脏腑气血，成为内伤病因。\n\n中医认为七情分别与五脏关系密切，即喜与心相应、怒与肝相应、思与脾相应、忧悲与肺相应、恐与肾相应。某种情绪过度时，容易影响相应脏腑；脏腑功能失调后，也可能反过来导致情绪变化。\n\n七情主要通过影响气机而致病，常概括为“怒则气上、喜则气缓、悲则气消、恐则气下、惊则气乱、思则气结”。例如，过怒可能出现头痛、面红、胸胁胀满；过思可能出现食欲不振、腹胀、失眠；惊恐过度可能出现心悸、神志不安或二便异常等表现。\n\n七情内伤通常直接影响内在脏腑，也可能导致气滞、血瘀、痰湿或阴阳失调。由于不同情志能够相互影响，具体表现还会因个人体质、情绪强度和持续时间而有所不同。医者需要结合患者的情志变化、脏腑症状以及望、闻、问、切所得信息综合判断。"
unlock_required_experience_points = 80
