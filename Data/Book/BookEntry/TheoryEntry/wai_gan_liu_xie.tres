script = ExtResource("1")
entry_id = "wai_gan_liu_xie"
book_id = "huang_di_nei_jing"
title = "外感六邪"
sort_index = 18
detail_text = "【外感六邪】\n\n外感六邪是中医对风、寒、暑、湿、燥、热六类外来致病因素的统称，又称“六淫”。风、寒、暑、湿、燥、热原本是自然界正常的气候变化，称为“六气”；当气候变化过于强烈、反常，或人体正气不足、适应能力下降时，六气便可能成为致病因素。\n\n外感六邪通常从皮毛、口鼻侵入人体，具有一定的季节性和地域性。例如春季多风、冬季多寒、长夏多湿、秋季多燥。六邪既可单独致病，也可相互结合，形成风寒、风热、寒湿、湿热等证候，在一定条件下还可能相互转化。\n\n不同邪气具有不同的致病特点，但人体患病后的具体表现还会受到体质、环境、病程及脏腑状态的影响。医者需要结合表里、寒热、虚实以及望、闻、问、切所得信息综合判断，不能仅凭季节或单一症状确定邪气种类。"
unlock_required_experience_points = 60
