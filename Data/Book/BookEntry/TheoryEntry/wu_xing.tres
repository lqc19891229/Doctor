[resource]
script = ExtResource("1")
entry_id = "wu_xing"
book_id = "huang_di_nei_jing"
title = "五行"
detail_text = "【五行】\n\n五行是以木、火、土、金、水五种属性，说明自然与人体之间相互联系、不断变化的规律。五行并非单指五种物质，而是对生长、温热、承载、收敛和滋润等不同特性的概括。\n\n五行之间既有相生，也有相克。木生火、火生土、土生金、金生水、水生木；木克土、土克水、水克火、火克金、金克木。中医以五行联系五脏：肝属木、心属火、脾属土、肺属金、肾属水。五脏彼此滋养、相互制约，共同维持人体平衡；若生克关系失常，也可能使疾病相互传变。\n\n【五行与五类相应】\n\n五行是中医用来归纳自然现象和人体功能的方法。木、火、土、金、水分别象征生长、温热、承载、收敛和闭藏。中医通过“取象比类”，将季节、气候、味道、颜色以及人体脏腑联系起来，从整体上观察人体与自然环境的变化。\n\n五行：木，火，土，金，水\n五季：春，夏，长夏，秋，冬\n五气：温，热，平，凉，寒\n五味：酸，苦，甘，辛，咸\n五色：青，赤，黄，白，黑\n五脏：肝，心，脾，肺，肾\n五腑：胆，小肠，胃，大肠，膀胱\n五官：目，舌，口，鼻，耳\n五志：怒，喜，思，悲，恐\n五体：筋，脉，肉，皮毛，骨\n五液：泪，汗，涎，涕，唾\n\n春季万物生发，属木，与风、酸味和肝相应；夏季气候炎热，属火，与暑、苦味和心相应；长夏湿气较盛，属土，与湿、甘味和脾相应；秋季万物收敛，属金，与燥、辛味和肺相应；冬季万物闭藏，属水，与寒、咸味和肾相应。\n\n这些对应关系并不是说五脏只会受到某一种季节、气候或味道影响，而是用来说明自然环境、饮食情志和人体功能之间可能存在的联系。医者可以据此观察疾病发生与传变的规律，但诊断时仍须结合患者的全部症状综合判断。"
unlock_required_experience_points = 20
