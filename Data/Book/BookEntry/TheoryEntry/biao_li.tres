[resource]
script = ExtResource("1")
entry_id = "biao_li"
book_id = "huang_di_nei_jing"
title = "表里"
detail_text = "【表里】\n\n表里是中医八纲辨证中用来判断疾病部位深浅和病势进退的两项纲领。表证通常指病邪位于皮毛、肌腠和经络，多见于外邪侵袭人体的初期；里证通常指病邪深入脏腑、气血或骨髓，也可由饮食、情志、劳倦等内伤因素直接形成。这里的表里并不单纯指身体的外部和内部，而是对病位与病势的综合判断。\n\n表证：常见恶寒发热、头痛身痛、鼻塞流涕、咳嗽、舌苔薄白、脉浮等表现。由于病邪尚在体表，通常病程较短，起病较急。\n\n里证：临床表现较为复杂，可见但热不寒、口渴、烦躁、腹痛、呕吐、腹泻、便秘、小便异常、舌苔厚或脉沉等表现。由于病变涉及脏腑气血，其症状会随寒热、虚实及所病脏腑的不同而有所变化。\n\n表证和里证可以同时存在，称为表里同病；疾病由表入里，通常表示病邪逐渐深入；由里出表，则可能表示病邪向外透达。医者需要结合寒热、虚实以及望、闻、问、切所得信息进行判断，不可只凭一个症状确定表里。辨明疾病部位后，表证通常以解表为基本方向，里证则根据具体的寒热虚实采取相应治法。"
unlock_required_experience_points = 10
