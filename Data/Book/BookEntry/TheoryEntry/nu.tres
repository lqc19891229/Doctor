[resource]
script = ExtResource("1")
entry_id = "nu"
book_id = "huang_di_nei_jing"
title = "怒"
sort_index = 31
detail_text = "【怒】\n\n怒是七情之一，是人在受到挫折、压迫或不公平对待时产生的正常情绪。适度表达愤怒有助于情绪疏解，但长期压抑、频繁发怒或突然暴怒，都可能影响人体气机。\n\n中医认为怒与肝相应。肝主疏泄，负责调畅气机；愤怒过度容易使肝的疏泄功能失常，导致气机上逆，称为“怒则气上”。\n\n怒伤肝时，常见头胀头痛、面红目赤、急躁易怒、胸胁胀满、口苦或眩晕等表现。肝气长期郁滞还可能影响脾胃，出现食欲不振、腹胀等症状。判断时需要区分肝气郁结、肝火上炎和肝阳上亢等不同情况。"
unlock_required_experience_points = 80
