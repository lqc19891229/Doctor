[resource]
script = ExtResource("1")
entry_id = "bei"
book_id = "huang_di_nei_jing"
title = "悲"
sort_index = 34
detail_text = "【悲】\n\n悲是七情之一，是人在经历失去、离别或重大打击时产生的哀伤情绪。适度悲伤属于正常的情感反应，但悲伤过度或长期不能缓解时，可能消耗人体之气，使精神和身体逐渐衰弱。\n\n中医认为悲与肺相应，悲伤过度容易耗伤肺气，称为“悲则气消”。肺气受损后，肺主气、司呼吸以及宣发肃降的功能可能受到影响。\n\n悲伤过度时，常见精神低落、气短乏力、声音低弱、胸闷、哭泣、食欲下降等表现。长期悲伤还可能进一步影响心、脾等脏腑。忧与悲都和肺有关，但忧偏于担心和愁虑，悲则偏于哀痛和失落。"
unlock_required_experience_points = 80
