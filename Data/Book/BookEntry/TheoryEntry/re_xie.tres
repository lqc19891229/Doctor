[resource]
script = ExtResource("1")
entry_id = "re_xie"
book_id = "huang_di_nei_jing"
title = "热邪"
sort_index = 24
detail_text = "【热邪】\n\n热邪是外感六邪之一，又常称为火邪。中医认为热为阳邪，性质炎热升腾，容易使人体出现阳热偏盛的表现。热邪可由外界侵入，也可由其他邪气在体内转化而成；热邪发展至较严重程度时，常称为火邪。\n\n热邪容易耗气伤津，常见高热、口渴喜冷饮、汗多、身体乏力、小便短黄、大便干结等表现。热邪具有炎上的特点，容易出现面红、目赤、咽喉肿痛、口舌生疮等人体上部症状。\n\n热邪还可能生风、动血或腐肉成脓。热极生风时可见抽搐、颈项强直等表现；热迫血行时可见出血、皮疹等表现；热邪壅聚局部时可能形成红、肿、热、痛的疮疡。判断热邪时，需要结合病位、病程及津液损伤程度综合分析。"
unlock_required_experience_points = 80
