[resource]
script = ExtResource("1")
entry_id = "ye"
book_id = "huang_di_nei_jing"
title = "液"
detail_text = "【液】\n\n液是人体正常水液的一部分，与津合称“津液”。中医认为液的性质较为稠厚、流动性相对较小，主要分布于脏腑、关节、骨髓和脑髓等较深部位。\n\n液具有濡养脏腑、滑利关节、充养骨髓和脑髓等作用，使关节活动灵活，并维持深部组织的滋润。液的生成、输布与排泄同样依赖脾、肺、肾和三焦等脏腑的协调作用。\n\n液不足时，可能出现关节活动不利、肌肤失润、口干咽燥、眩晕或身体消瘦等表现；液的运行失常时，也可能停聚形成痰饮、水湿等病理产物。一般而言，津偏于清稀并滋润体表，液偏于稠厚并濡养体内，但二者之间没有绝对界限。"
unlock_required_experience_points = 40
