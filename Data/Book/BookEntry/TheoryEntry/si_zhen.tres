[resource]
script = ExtResource("1")
entry_id = "si_zhen"
book_id = "huang_di_nei_jing"
title = "四诊"
sort_index = 1
detail_text = "【四诊】\n\n四诊是中医收集患者病情资料的四种基本诊察方法，包括望诊、闻诊、问诊和切诊。医者通过观察、听闻、询问和触按患者所表现出的各种信息，了解疾病的病因、病位、性质以及正邪盛衰，为辨证和治疗提供依据。\n\n望诊是观察患者的神、色、形、态以及舌象和局部变化；\n闻诊包括听声音和嗅气味，如辨别说话、呼吸、咳嗽等声音及异常气味；\n问诊是询问疾病经过、主要症状、生活习惯及既往情况；\n切诊包括脉诊和按诊，通过切脉与触按身体了解脉象及局部变化。\n\n【寸关尺】\n寸、关、尺是脉诊中的三个把脉位置，在手腕桡骨动脉上。医者通过按压这三个位置，感受脉象的强弱、快慢、沉浮、流畅程度，从而推测人体不同区域和脏腑的健康状况。\n\n【对应脏腑区域】\n浮脉：表\n左寸：心\n左关：肝\n左尺：肾阴\n右寸：肺\n右关：脾\n右尺：肾阳"
unlock_required_experience_points = 0
